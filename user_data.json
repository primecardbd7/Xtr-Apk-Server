{"code":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Movie Flix Pro<\/title>\n    <link href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.0\/css\/all.min.css\" rel=\"stylesheet\">\n    <style>\n        \/* --- CSS VARIABLES & THEMES --- *\/\n        :root {\n            --bg: #000000;\n            --card-bg: #141414;\n            --primary: #E50914; \/* Netflix Red *\/\n            --text: #ffffff;\n            --text-sec: #b3b3b3;\n            --star-color: #ffd700;\n            --overlay: rgba(0,0,0,0.95);\n            --gradient: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);\n        }\n        \n        body.light-mode {\n            --bg: #f5f5f5;\n            --card-bg: #ffffff;\n            --primary: #E50914;\n            --text: #000000;\n            --text-sec: #555555;\n            --overlay: rgba(255,255,255,0.98);\n        }\n\n        * { box-sizing: border-box; outline: none; -webkit-tap-highlight-color: transparent; }\n        body { margin: 0; font-family: 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); padding-bottom: 80px; transition: background 0.3s, color 0.3s; overflow-x: hidden; user-select: none; }\n\n        \/* SMOOTH ANIMATIONS *\/\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n        .fade-in { animation: fadeIn 0.4s ease-out forwards; }\n\n        \/* --- CUSTOM NOTIFICATION --- *\/\n        #notification-area {\n            position: fixed; top: -100px; left: 0; width: 100%; z-index: 9000;\n            display: flex; justify-content: center; transition: top 0.5s cubic-bezier(0.68, -0.55, 0.27, 1.55);\n        }\n        .toast-msg {\n            background: rgba(30, 30, 30, 0.95); backdrop-filter: blur(10px); color: white; padding: 12px 25px;\n            border-radius: 50px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n            border-left: 4px solid var(--primary); display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 14px;\n        }\n\n        \/* --- REDESIGNED AUTH SCREEN --- *\/\n        #auth-screen { \n            display: flex; flex-direction: column; justify-content: center; align-items: center; \n            height: 100vh; width: 100vw;\n            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.9)), url('https:\/\/assets.nflxext.com\/ffe\/siteui\/vlv3\/f841d4c7-10e1-40af-bcae-07a3f8dc141a\/f6d7434e-d6de-4185-a6d4-c77a2d08737b\/US-en-20220502-popsignuptwoweeks-perspective_alpha_website_medium.jpg'); \n            background-size: cover; background-position: center;\n            padding: 20px; \n        }\n        .auth-box { \n            background: rgba(0, 0, 0, 0.75); padding: 50px 35px; border-radius: 16px; \n            width: 100%; max-width: 400px; backdrop-filter: blur(15px); \n            border: 1px solid rgba(255,255,255,0.1); \n            box-shadow: 0 15px 40px rgba(0,0,0,0.6);\n            animation: fadeIn 0.6s ease-out;\n        }\n        .auth-box h1 { color: var(--text); margin: 0 0 10px 0; text-align: left; font-size: 32px; font-weight: 700; }\n        .auth-sub { text-align: left; color: #aaa; margin-bottom: 30px; font-size: 14px; }\n        .input-group { position: relative; margin-bottom: 20px; }\n        .input-group input { \n            width: 100%; padding: 18px 20px; background: #333; border: none; \n            border-radius: 4px; color: white; font-size: 16px; transition: 0.3s;\n        }\n        .input-group input:focus { background: #444; outline: 2px solid #555; }\n        \n        .auth-btn { \n            width: 100%; padding: 16px; background: var(--primary); color: white; \n            border: none; border-radius: 4px; font-size: 16px; font-weight: 700; \n            cursor: pointer; transition: 0.2s; margin-top: 10px;\n        }\n        .auth-btn:active { transform: scale(0.98); background: #c40812; }\n        \n        .toggle-auth { margin-top: 25px; text-align: left; color: #8c8c8c; font-size: 15px; cursor: pointer; }\n        .toggle-auth span { color: white; font-weight: 500; margin-left: 5px; }\n        .toggle-auth span:hover { text-decoration: underline; }\n\n        \/* --- HOME SCREEN --- *\/\n        #app-screen { display: none; }\n        \n        \/* Header *\/\n        .top-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; position: sticky; top: 0; z-index: 100; background: var(--bg); }\n        .brand-logo { color: var(--primary); font-weight: 900; font-size: 26px; letter-spacing: 1px; text-shadow: 0 2px 10px rgba(229, 9, 20, 0.3); }\n        .search-icon-btn { font-size: 20px; color: var(--text); cursor: pointer; padding: 10px; }\n\n        \/* Slider *\/\n        .slider-container { width: 100%; height: 55vh; max-height: 450px; overflow: hidden; position: relative; margin-bottom: 20px; mask-image: linear-gradient(to bottom, black 80%, transparent 100%); }\n        .slider-wrapper { display: flex; transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); height: 100%; }\n        .slide { min-width: 100%; height: 100%; background-size: cover; background-position: center; position: relative; }\n        .slide-overlay { position: absolute; bottom: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to top, var(--bg) 0%, transparent 60%); }\n        \n        .slide-dots { position: absolute; bottom: 20px; right: 20px; display: flex; gap: 8px; z-index: 10; }\n        .dot { width: 8px; height: 8px; background: rgba(255,255,255,0.3); border-radius: 50%; transition: 0.3s; }\n        .dot.active { background: var(--text); transform: scale(1.2); }\n\n        \/* Movie Grid *\/\n        .section-header { padding: 0 20px; font-size: 19px; font-weight: 700; color: var(--text); margin: 10px 0 15px; display: flex; align-items: center; gap: 10px; }\n        .section-header::before { content:''; width: 4px; height: 20px; background: var(--primary); border-radius: 2px; }\n        \n        .movie-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 0 15px; }\n        @media (max-width: 400px) { .movie-grid { grid-template-columns: repeat(2, 1fr); } }\n        \n        .movie-card { cursor: pointer; position: relative; border-radius: 6px; overflow: hidden; transition: transform 0.2s; }\n        .movie-card:active { transform: scale(0.96); }\n        .movie-poster { width: 100%; aspect-ratio: 2\/3; object-fit: cover; background: #222; border-radius: 6px; }\n        \n        \/* --- SEARCH VIEW --- *\/\n        #search-view { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg); z-index: 4000; padding: 20px; overflow-y: auto; }\n        .search-bar-wrap { position: relative; margin-bottom: 20px; display: flex; align-items: center; gap: 15px; background: var(--card-bg); padding: 5px 15px 5px 5px; border-radius: 8px; border: 1px solid #333; }\n        .search-back { font-size: 20px; color: var(--text); cursor: pointer; padding: 10px; }\n        .search-inp { width: 100%; padding: 10px; border: none; background: transparent; color: var(--text); font-size: 16px; }\n        .search-results { display: grid; grid-template-columns: 1fr; gap: 10px; }\n        .search-item { display: flex; gap: 15px; align-items: center; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px; cursor: pointer; }\n        .search-item img { width: 50px; height: 75px; object-fit: cover; border-radius: 4px; }\n        \n        \/* --- MOVIE DETAILS POPUP --- *\/\n        #movie-popup { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg); z-index: 3000; overflow-y: auto; }\n        .p-img-box { position: relative; height: 400px; width: 100%; }\n        .p-img-box img { width: 100%; height: 100%; object-fit: cover; mask-image: linear-gradient(to bottom, black 50%, transparent 100%); }\n        .p-close { position: absolute; top: 20px; left: 20px; background: rgba(0,0,0,0.5); backdrop-filter: blur(5px); color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; z-index: 10; border: 1px solid rgba(255,255,255,0.1); }\n        .p-content { padding: 0 20px 80px; text-align: center; margin-top: -60px; position: relative; z-index: 2; }\n        .p-title { font-size: 32px; font-weight: 800; margin-bottom: 5px; text-shadow: 0 2px 10px rgba(0,0,0,0.8); line-height: 1.2; }\n        \n        .rating-container { display: inline-flex; align-items: center; gap: 5px; margin: 15px 0 25px; background: rgba(255,255,255,0.08); padding: 8px 16px; border-radius: 30px; backdrop-filter: blur(5px); }\n        .star { font-size: 18px; color: #444; cursor: pointer; transition: 0.2s; }\n        .star.active { color: var(--star-color); text-shadow: 0 0 10px rgba(255, 215, 0, 0.4); }\n        .rating-text { font-size: 13px; color: var(--text-sec); margin-left: 8px; font-weight: 600; }\n\n        .p-btn { width: 100%; padding: 16px; background: var(--text); color: var(--bg); border: none; border-radius: 8px; font-size: 18px; font-weight: 700; margin-bottom: 25px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: 0.2s; }\n        .p-btn:active { transform: scale(0.97); opacity: 0.9; }\n        .p-btn i { font-size: 20px; }\n        .p-desc { color: var(--text-sec); line-height: 1.6; font-size: 15px; text-align: justify; }\n\n        \/* --- VIDEO PLAYER (NETFLIX STYLE) --- *\/\n        #video-player-view { \n            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; \n            background: #000; z-index: 8000; overflow: hidden; \n        }\n        \n        \/* Landscape rotation logic for Mobile *\/\n        .player-content {\n            width: 100%; height: 100%; position: relative; background: #000;\n        }\n\n        \/* Force landscape on Portrait devices *\/\n        @media screen and (orientation: portrait) {\n            .rotate-mode .player-content {\n                width: 100vh; height: 100vw;\n                position: absolute; top: 50%; left: 50%;\n                transform: translate(-50%, -50%) rotate(90deg);\n            }\n        }\n\n        .player-header {\n            position: absolute; top: 0; left: 0; width: 100%; padding: 20px;\n            background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);\n            z-index: 8005; display: flex; align-items: center; gap: 15px;\n            opacity: 0; transition: opacity 0.5s; pointer-events: none; \/* Auto hide *\/\n        }\n        .player-content:hover .player-header, .player-content:active .player-header { opacity: 1; pointer-events: auto; }\n        \n        .player-back { font-size: 24px; color: white; cursor: pointer; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5)); }\n        .player-title { color: white; font-size: 18px; font-weight: 600; text-shadow: 0 2px 4px rgba(0,0,0,0.8); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n\n        iframe.video-frame {\n            width: 100%; height: 100%; border: none; background: #000;\n        }\n\n        \/* --- PROFILE --- *\/\n        #profile-view { display: none; padding: 20px; margin-top: 20px; }\n        .profile-img-wrap { width: 100px; height: 100px; margin: 0 auto 15px; position: relative; border-radius: 8px; overflow: hidden; border: 2px solid var(--text); }\n        .profile-pic { width: 100%; height: 100%; object-fit: cover; }\n        .edit-badge { position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(0,0,0,0.7); color: white; text-align: center; padding: 5px; font-size: 10px; cursor: pointer; }\n        \n        .stats-container { display: flex; justify-content: center; gap: 15px; margin-top: 25px; }\n        .stat-box { background: var(--card-bg); padding: 15px; border-radius: 8px; text-align: center; min-width: 90px; border: 1px solid #333; }\n        .stat-num { font-size: 20px; font-weight: 800; color: var(--primary); display: block; }\n\n        \/* --- SETTINGS --- *\/\n        #settings-view { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg); z-index: 5000; padding: 20px; animation: fadeIn 0.3s; }\n        .setting-item { display: flex; justify-content: space-between; align-items: center; background: var(--card-bg); padding: 18px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #222; }\n        .switch { position: relative; display: inline-block; width: 46px; height: 24px; }\n        .switch input { opacity: 0; width: 0; height: 0; }\n        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #555; transition: .4s; border-radius: 34px; }\n        .slider:before { position: absolute; content: \"\"; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }\n        input:checked + .slider { background-color: var(--primary); }\n        input:checked + .slider:before { transform: translateX(22px); }\n\n        \/* --- BOTTOM NAV --- *\/\n        .bottom-nav { position: fixed; bottom: 0; width: 100%; background: rgba(20, 20, 20, 0.95); backdrop-filter: blur(10px); height: 65px; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #333; z-index: 1000; padding-bottom: 5px; }\n        .nav-item { color: #666; font-size: 20px; cursor: pointer; transition: 0.2s; display: flex; flex-direction: column; align-items: center; gap: 5px; width: 50%; }\n        .nav-item span { font-size: 10px; font-weight: 500; }\n        .nav-item.active { color: white; }\n        .nav-item.active i { transform: translateY(-2px); color: var(--primary); }\n\n        \/* Modal *\/\n        #edit-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 7000; justify-content: center; align-items: center; backdrop-filter: blur(5px); }\n        .modal-card { background: #1a1a1a; width: 85%; max-width: 350px; padding: 25px; border-radius: 12px; text-align: center; border: 1px solid #333; }\n        .modal-inp { width: 100%; padding: 14px; background: #333; border: 1px solid #444; color: white; margin-bottom: 15px; border-radius: 6px; }\n\n    <\/style>\n<\/head>\n<body>\n\n    <!-- CUSTOM NOTIFICATION AREA -->\n    <div id=\"notification-area\"><\/div>\n\n    <!-- AUTH SCREEN -->\n    <div id=\"auth-screen\">\n        <div class=\"auth-box\">\n            <h1 id=\"auth-title\">Sign In<\/h1>\n            <p id=\"auth-sub\" class=\"auth-sub\">Welcome back to Movie Flix Pro<\/p>\n            <div class=\"input-group\">\n                <input type=\"email\" id=\"email\" placeholder=\"Email or phone number\">\n            <\/div>\n            <div class=\"input-group\">\n                <input type=\"password\" id=\"password\" placeholder=\"Password\">\n            <\/div>\n            <button class=\"auth-btn\" id=\"auth-action-btn\" onclick=\"authHandler()\">Sign In<\/button>\n            \n            <div class=\"toggle-auth\" onclick=\"toggleAuthMode()\">\n                New to Movie Flix? <span id=\"toggle-text\">Sign up now.<\/span>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- MAIN APP SCREEN -->\n    <div id=\"app-screen\">\n        <!-- HEADER -->\n        <div class=\"top-header\" id=\"home-header\">\n            <div class=\"brand-logo\">MOVIE FLIX<\/div>\n            <div class=\"search-icon-btn\" onclick=\"openSearch()\"><i class=\"fas fa-search\"><\/i><\/div>\n        <\/div>\n\n        <!-- HOME TAB -->\n        <div id=\"home-view\" class=\"fade-in\">\n            <div class=\"slider-container\" id=\"slider-container\">\n                <div class=\"slider-wrapper\" id=\"slider-wrapper\"><\/div>\n                <div class=\"slide-dots\" id=\"dots-container\"><\/div>\n            <\/div>\n            <div class=\"section-header\">Trending Now<\/div>\n            <div class=\"movie-grid\" id=\"movie-list\"><\/div>\n        <\/div>\n\n        <!-- SEARCH OVERLAY -->\n        <div id=\"search-view\">\n            <div class=\"search-bar-wrap\">\n                <i class=\"fas fa-arrow-left search-back\" onclick=\"closeSearch()\"><\/i>\n                <input type=\"text\" id=\"search-inp\" class=\"search-inp\" placeholder=\"Search movies, TV shows...\" onkeyup=\"handleSearch()\">\n            <\/div>\n            <div class=\"search-results\" id=\"search-results\"><\/div>\n        <\/div>\n\n        <!-- PROFILE TAB -->\n        <div id=\"profile-view\" class=\"fade-in\">\n            <div style=\"text-align: right; margin-bottom: 10px;\">\n                <i class=\"fas fa-cog\" style=\"font-size: 24px; cursor: pointer;\" onclick=\"openSettings()\"><\/i>\n            <\/div>\n            <div class=\"profile-header\" style=\"text-align: center;\">\n                <div class=\"profile-img-wrap\" onclick=\"openEditModal()\">\n                    <img src=\"\" id=\"user-img\" class=\"profile-pic\">\n                    <div class=\"edit-badge\">EDIT<\/div>\n                <\/div>\n                <h2 id=\"user-name\" style=\"margin-bottom: 5px;\">User<\/h2>\n                <p id=\"user-email-text\" style=\"color:var(--text-sec); margin:0; font-size: 14px;\">user@email.com<\/p>\n\n                <div class=\"stats-container\">\n                    <div class=\"stat-box\">\n                        <span class=\"stat-num\" id=\"stat-watched\">0<\/span>\n                        <span class=\"stat-label\" style=\"font-size:12px; color:#888;\">Watched<\/span>\n                    <\/div>\n                    <div class=\"stat-box\">\n                        <span class=\"stat-num\" id=\"stat-rated\">0<\/span>\n                        <span class=\"stat-label\" style=\"font-size:12px; color:#888;\">Rated<\/span>\n                    <\/div>\n                <\/div>\n            <\/div>\n        <\/div>\n\n        <!-- SETTINGS VIEW -->\n        <div id=\"settings-view\">\n            <div class=\"settings-header\" style=\"display:flex; align-items:center; font-size:20px; font-weight:bold; margin-bottom:30px;\">\n                <i class=\"fas fa-arrow-left\" onclick=\"closeSettings()\" style=\"margin-right:15px; cursor:pointer;\"><\/i> Settings\n            <\/div>\n            <div class=\"setting-item\">\n                <span>Dark Mode<\/span>\n                <label class=\"switch\"><input type=\"checkbox\" id=\"theme-toggle\" onclick=\"toggleTheme()\"><span class=\"slider\"><\/span><\/label>\n            <\/div>\n            <div class=\"setting-item\" style=\"border-color: rgba(229,9,20,0.3); color: var(--primary); cursor: pointer;\" onclick=\"logout()\">\n                <span>Sign Out<\/span><i class=\"fas fa-sign-out-alt\"><\/i>\n            <\/div>\n        <\/div>\n\n        <!-- BOTTOM NAVIGATION -->\n        <div class=\"bottom-nav\">\n            <div class=\"nav-item active\" onclick=\"switchTab('home')\"><i class=\"fas fa-home\"><\/i><span>Home<\/span><\/div>\n            <div class=\"nav-item\" onclick=\"switchTab('profile')\"><i class=\"fas fa-user\"><\/i><span>Profile<\/span><\/div>\n        <\/div>\n    <\/div>\n\n    <!-- MOVIE DETAILS POPUP -->\n    <div id=\"movie-popup\">\n        <div class=\"p-img-box\">\n            <div class=\"p-close\" onclick=\"closePopup()\"><i class=\"fas fa-arrow-left\"><\/i><\/div>\n            <img src=\"\" id=\"p-img\">\n        <\/div>\n        <div class=\"p-content\">\n            <h1 id=\"p-title\" class=\"p-title\">Movie Title<\/h1>\n            \n            <div class=\"rating-container\">\n                <i class=\"fas fa-star star\" onclick=\"submitRating(1)\"><\/i>\n                <i class=\"fas fa-star star\" onclick=\"submitRating(2)\"><\/i>\n                <i class=\"fas fa-star star\" onclick=\"submitRating(3)\"><\/i>\n                <i class=\"fas fa-star star\" onclick=\"submitRating(4)\"><\/i>\n                <i class=\"fas fa-star star\" onclick=\"submitRating(5)\"><\/i>\n                <span id=\"avg-rating\" class=\"rating-text\">0.0 (0)<\/span>\n            <\/div>\n\n            <button class=\"p-btn\" onclick=\"watchNow()\">\n                <i class=\"fas fa-play\"><\/i> Watch Now\n            <\/button>\n            \n            <p id=\"p-desc\" class=\"p-desc\">Movie description goes here...<\/p>\n        <\/div>\n    <\/div>\n\n    <!-- VIDEO PLAYER OVERLAY (Netflix Style) -->\n    <div id=\"video-player-view\">\n        <div class=\"rotate-mode\">\n            <div class=\"player-content\">\n                <div class=\"player-header\">\n                    <i class=\"fas fa-arrow-left player-back\" onclick=\"closePlayer()\"><\/i>\n                    <span id=\"player-movie-title\" class=\"player-title\">Movie Title<\/span>\n                <\/div>\n                <!-- Iframe for Video -->\n                <iframe id=\"main-video-player\" class=\"video-frame\" src=\"\" allowfullscreen allow=\"autoplay; fullscreen\"><\/iframe>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- PROFILE EDIT MODAL -->\n    <div id=\"edit-modal\">\n        <div class=\"modal-card\">\n            <h3 style=\"margin-top:0; margin-bottom: 20px;\">Update Profile<\/h3>\n            <input type=\"text\" id=\"edit-name\" class=\"modal-inp\" placeholder=\"Display Name\">\n            <input type=\"text\" id=\"edit-pic\" class=\"modal-inp\" placeholder=\"Photo URL\">\n            <button class=\"auth-btn\" onclick=\"saveProfile()\">Save<\/button>\n            <button class=\"auth-btn\" style=\"background: transparent; color: #aaa; margin-top: 5px;\" onclick=\"document.getElementById('edit-modal').style.display='none'\">Cancel<\/button>\n        <\/div>\n    <\/div>\n\n    <!-- FIREBASE LOGIC -->\n    <script type=\"module\">\n        import { initializeApp } from \"https:\/\/www.gstatic.com\/firebasejs\/9.6.1\/firebase-app.js\";\n        import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, onAuthStateChanged, updateProfile, signOut } from \"https:\/\/www.gstatic.com\/firebasejs\/9.6.1\/firebase-auth.js\";\n        import { getFirestore, collection, getDocs, doc, setDoc, getDoc, updateDoc, increment } from \"https:\/\/www.gstatic.com\/firebasejs\/9.6.1\/firebase-firestore.js\";\n\n        const firebaseConfig = {\n            apiKey: \"AIzaSyBzmiXbnymeKc5y-7PWzp8S-gSAa2chXO0\",\n            authDomain: \"movie-app-pro-c3467.firebaseapp.com\",\n            projectId: \"movie-app-pro-c3467\",\n            storageBucket: \"movie-app-pro-c3467.firebasestorage.app\",\n            messagingSenderId: \"1036890895504\",\n            appId: \"1:1036890895504:web:7796c73babced278ca9415\"\n        };\n\n        const app = initializeApp(firebaseConfig);\n        const auth = getAuth(app);\n        const db = getFirestore(app);\n        \n        let currentLink = \"\";\n        let currentMovieId = \"\";\n        let sliderInterval;\n        let isLoginMode = true;\n        let allMovies = [];\n\n        \/\/ TOAST NOTIFICATION\n        window.showToast = (msg, type='info') => {\n            const area = document.getElementById('notification-area');\n            const color = type === 'error' ? '#ff4444' : '#00C851';\n            const icon = type === 'error' ? '<i class=\"fas fa-exclamation-triangle\"><\/i>' : '<i class=\"fas fa-check-circle\"><\/i>';\n            area.innerHTML = `<div class=\"toast-msg\" style=\"border-left-color:${color}\">${icon} <span>${msg}<\/span><\/div>`;\n            area.style.top = '30px';\n            setTimeout(() => { area.style.top = '-100px'; }, 3000);\n        };\n\n        \/\/ AUTH HANDLING\n        window.toggleAuthMode = () => {\n            isLoginMode = !isLoginMode;\n            const title = document.getElementById('auth-title');\n            const sub = document.getElementById('auth-sub');\n            const btn = document.getElementById('auth-action-btn');\n            const toggle = document.getElementById('toggle-text');\n\n            if(isLoginMode) {\n                title.innerText = \"Sign In\";\n                sub.innerText = \"Welcome back to Movie Flix Pro\";\n                btn.innerText = \"Sign In\";\n                toggle.innerText = \"Sign up now.\";\n            } else {\n                title.innerText = \"Sign Up\";\n                sub.innerText = \"Unlimited movies, TV shows, and more\";\n                btn.innerText = \"Sign Up\";\n                toggle.innerText = \"Sign in.\";\n            }\n        };\n\n        window.authHandler = async () => {\n            const e = document.getElementById('email').value;\n            const p = document.getElementById('password').value;\n            if(!e || !p) { showToast(\"Please fill all fields\", 'error'); return; }\n            \n            const btn = document.getElementById('auth-action-btn');\n            btn.innerHTML = '<i class=\"fas fa-spinner fa-spin\"><\/i> Processing...';\n\n            try { \n                if(isLoginMode) {\n                    await signInWithEmailAndPassword(auth, e, p);\n                    showToast(\"Welcome back!\");\n                } else {\n                    const cred = await createUserWithEmailAndPassword(auth, e, p);\n                    await setDoc(doc(db, \"users\", cred.user.uid), { watchedCount: 0, ratedCount: 0 });\n                    showToast(\"Account created successfully!\");\n                }\n            } catch(err) { \n                showToast(err.message.replace(\"Firebase:\", \"\").replace(\"auth\/\", \"\"), 'error'); \n            } finally {\n                btn.innerText = isLoginMode ? \"Sign In\" : \"Sign Up\";\n            }\n        };\n\n        window.logout = () => { signOut(auth); location.reload(); };\n\n        onAuthStateChanged(auth, u => {\n            if(u) {\n                document.getElementById('auth-screen').style.display='none';\n                document.getElementById('app-screen').style.display='block';\n                updateUserUI(u);\n                loadData();\n                loadUserData(u.uid);\n                loadTheme();\n            } else {\n                document.getElementById('auth-screen').style.display='flex';\n                document.getElementById('app-screen').style.display='none';\n            }\n        });\n\n        function updateUserUI(u) {\n            document.getElementById('user-img').src = u.photoURL || 'https:\/\/upload.wikimedia.org\/wikipedia\/commons\/0\/0b\/Netflix-avatar.png';\n            document.getElementById('user-name').innerText = u.displayName || 'Member';\n            document.getElementById('user-email-text').innerText = u.email;\n        }\n\n        async function loadUserData(uid) {\n            try {\n                const userSnap = await getDoc(doc(db, \"users\", uid));\n                if(userSnap.exists()) {\n                    const d = userSnap.data();\n                    document.getElementById('stat-watched').innerText = d.watchedCount || 0;\n                    document.getElementById('stat-rated').innerText = d.ratedCount || 0;\n                } else {\n                    await setDoc(doc(db, \"users\", uid), { watchedCount: 0, ratedCount: 0 });\n                }\n            } catch(e) { console.log(e); }\n        }\n\n        async function loadData() {\n            \/\/ Slider\n            const bSnap = await getDocs(collection(db, \"banners\"));\n            const wrap = document.getElementById('slider-wrapper');\n            const dots = document.getElementById('dots-container');\n            wrap.innerHTML = ''; dots.innerHTML = '';\n            \n            let banners = [];\n            bSnap.forEach(d => banners.push(d.data().url));\n            if(banners.length === 0) banners = ['https:\/\/image.tmdb.org\/t\/p\/original\/9PqD3wSIjntyJDBzMNuxuKHwpUD.jpg', 'https:\/\/image.tmdb.org\/t\/p\/original\/mRuA79a66zC8g9u9d2D5P3Qz.jpg'];\n\n            banners.forEach((url, i) => {\n                const s = document.createElement('div'); s.className = 'slide'; \n                s.style.backgroundImage = `url('${url}')`;\n                s.innerHTML = '<div class=\"slide-overlay\"><\/div>';\n                wrap.appendChild(s);\n                const d = document.createElement('div'); d.className = i===0?'dot active':'dot';\n                dots.appendChild(d);\n            });\n            if(banners.length > 1) startSlider(banners.length);\n\n            \/\/ Movies\n            const mList = document.getElementById('movie-list');\n            mList.innerHTML = '';\n            allMovies = [];\n            \n            const mSnap = await getDocs(collection(db, \"movies\"));\n            mSnap.forEach(d => {\n                const m = d.data();\n                const mObj = { id: d.id, ...m };\n                allMovies.push(mObj);\n            });\n\n            \/\/ Initial Load (Reverse to show newest first if needed, or just slice)\n            allMovies.slice(0, 12).forEach(m => {\n                const div = document.createElement('div');\n                div.className = 'movie-card';\n                div.innerHTML = `<img src=\"${m.img}\" class=\"movie-poster\" onclick=\"openMFromObj('${m.id}')\">`;\n                mList.appendChild(div);\n            });\n        }\n\n        function startSlider(total) {\n            let idx = 0;\n            const wrap = document.getElementById('slider-wrapper');\n            const dots = document.querySelectorAll('.dot');\n            function move(n) {\n                idx = n; if(idx >= total) idx=0; if(idx < 0) idx=total-1;\n                wrap.style.transform = `translateX(-${idx*100}%)`;\n                dots.forEach(d=>d.classList.remove('active')); dots[idx].classList.add('active');\n            }\n            clearInterval(sliderInterval); sliderInterval = setInterval(()=>move(idx+1), 5000);\n        }\n\n        \/\/ SEARCH\n        window.openSearch = () => {\n            document.getElementById('search-view').style.display = 'block';\n            document.getElementById('search-inp').focus();\n            document.querySelector('.bottom-nav').style.display = 'none';\n        };\n\n        window.closeSearch = () => {\n            document.getElementById('search-view').style.display = 'none';\n            document.querySelector('.bottom-nav').style.display = 'flex';\n            document.getElementById('search-inp').value = '';\n            document.getElementById('search-results').innerHTML = '';\n        };\n\n        window.handleSearch = () => {\n            const query = document.getElementById('search-inp').value.toLowerCase();\n            const resBox = document.getElementById('search-results');\n            resBox.innerHTML = '';\n            if(query.length === 0) return;\n            const results = allMovies.filter(m => m.name.toLowerCase().includes(query));\n            if(results.length === 0) {\n                resBox.innerHTML = '<div style=\"text-align:center; padding:20px; color:#666\">No results found.<\/div>';\n                return;\n            }\n            results.forEach(m => {\n                const div = document.createElement('div');\n                div.className = 'search-item';\n                div.onclick = () => { openMFromObj(m.id); };\n                div.innerHTML = `\n                    <img src=\"${m.img}\">\n                    <div class=\"s-info\">\n                        <h4 style=\"margin:0; color:var(--text);\">${m.name}<\/h4>\n                        <span style=\"font-size:12px; color:var(--text-sec);\">${m.avgRating ? m.avgRating.toFixed(1) : '0.0'} <i class=\"fas fa-star\" style=\"color:gold;\"><\/i><\/span>\n                    <\/div>\n                `;\n                resBox.appendChild(div);\n            });\n        };\n\n        window.openMFromObj = (id) => {\n            const m = allMovies.find(x => x.id === id);\n            if(m) {\n                openM(m.id, m.name, m.img, m.desc, m.link, m.avgRating || 0, m.totalVotes || 0);\n                document.getElementById('search-view').style.display = 'none';\n                document.querySelector('.bottom-nav').style.display = 'flex';\n            }\n        };\n\n        \/\/ POPUP\n        window.openM = async (id, t, i, d, l, avg, votes) => {\n            currentMovieId = id;\n            currentLink = l;\n            document.getElementById('movie-popup').style.display='block';\n            document.getElementById('p-title').innerText = t;\n            document.getElementById('p-img').src = i;\n            document.getElementById('p-desc').innerText = d;\n            document.getElementById('avg-rating').innerText = `${avg ? avg.toFixed(1) : '0.0'} (${votes})`;\n            \n            const userId = auth.currentUser.uid;\n            const ratingDoc = await getDoc(doc(db, \"movies\", id, \"ratings\", userId));\n            updateStars(ratingDoc.exists() ? ratingDoc.data().stars : 0);\n        };\n\n        window.updateStars = (count) => {\n            const stars = document.querySelectorAll('.star');\n            stars.forEach((s, index) => {\n                if(index < count) s.classList.add('active');\n                else s.classList.remove('active');\n            });\n        };\n\n        window.submitRating = async (stars) => {\n            if(!auth.currentUser) return;\n            const userId = auth.currentUser.uid;\n            const movieRef = doc(db, \"movies\", currentMovieId);\n            const ratingRef = doc(db, \"movies\", currentMovieId, \"ratings\", userId);\n            const userRef = doc(db, \"users\", userId);\n\n            try {\n                const prevSnap = await getDoc(ratingRef);\n                if(prevSnap.exists()) { showToast(\"Already rated!\", 'info'); return; }\n                await setDoc(ratingRef, { stars: stars, userId: userId });\n                updateStars(stars);\n                const mSnap = await getDoc(movieRef);\n                const d = mSnap.data();\n                const newVotes = (d.totalVotes || 0) + 1;\n                const newTotal = (d.totalRatingSum || 0) + stars;\n                const newAvg = newTotal \/ newVotes;\n                await updateDoc(movieRef, { totalRatingSum: newTotal, totalVotes: newVotes, avgRating: newAvg });\n                document.getElementById('avg-rating').innerText = `${newAvg.toFixed(1)} (${newVotes})`;\n                await updateDoc(userRef, { ratedCount: increment(1) });\n                document.getElementById('stat-rated').innerText = parseInt(document.getElementById('stat-rated').innerText) + 1;\n                showToast(\"Rating submitted!\");\n            } catch(e) { showToast(\"Error\", 'error'); }\n        };\n\n        \/\/ --- NEW VIDEO PLAYER LOGIC (NETFLIX STYLE) ---\n        window.watchNow = async () => {\n            if (!currentLink) { showToast(\"Link not available\", 'error'); return; }\n\n            const playerView = document.getElementById('video-player-view');\n            const iframe = document.getElementById('main-video-player');\n            const title = document.getElementById('player-movie-title');\n            \n            \/\/ Set Content\n            title.innerText = document.getElementById('p-title').innerText;\n            iframe.src = currentLink;\n            \n            \/\/ Show Player Overlay\n            playerView.style.display = 'block';\n            document.getElementById('movie-popup').style.display = 'none';\n\n            \/\/ Try Fullscreen API\n            const elem = document.documentElement;\n            if (elem.requestFullscreen) { elem.requestFullscreen(); } \n            else if (elem.webkitRequestFullscreen) { elem.webkitRequestFullscreen(); }\n\n            \/\/ Increment Watch Count\n            if(auth.currentUser) {\n                const userRef = doc(db, \"users\", auth.currentUser.uid);\n                await updateDoc(userRef, { watchedCount: increment(1) });\n                const el = document.getElementById('stat-watched');\n                el.innerText = parseInt(el.innerText) + 1;\n            }\n        };\n\n        window.closePlayer = () => {\n            const playerView = document.getElementById('video-player-view');\n            const iframe = document.getElementById('main-video-player');\n            \n            \/\/ Stop Video\n            iframe.src = \"\"; \n            playerView.style.display = 'none';\n            document.getElementById('movie-popup').style.display = 'block';\n\n            \/\/ Exit Fullscreen\n            if (document.exitFullscreen) { document.exitFullscreen(); }\n            else if (document.webkitExitFullscreen) { document.webkitExitFullscreen(); }\n        };\n\n        window.closePopup = () => document.getElementById('movie-popup').style.display='none';\n\n        \/\/ SETTINGS & EDIT\n        window.openSettings = () => document.getElementById('settings-view').style.display='block';\n        window.closeSettings = () => document.getElementById('settings-view').style.display='none';\n        \n        window.toggleTheme = () => {\n            document.body.classList.toggle('light-mode');\n            const isLight = document.body.classList.contains('light-mode');\n            localStorage.setItem('theme', isLight ? 'light' : 'dark');\n            document.getElementById('theme-toggle').checked = !isLight;\n        };\n        \n        function loadTheme() {\n            const t = localStorage.getItem('theme');\n            if(t === 'light') { document.body.classList.add('light-mode'); document.getElementById('theme-toggle').checked = false; }\n            else { document.body.classList.remove('light-mode'); document.getElementById('theme-toggle').checked = true; }\n        }\n\n        window.switchTab = (t) => {\n            const navs = document.querySelectorAll('.nav-item');\n            if(t==='home') {\n                document.getElementById('home-view').style.display='block'; document.getElementById('profile-view').style.display='none';\n                navs[0].classList.add('active'); navs[1].classList.remove('active');\n            } else {\n                document.getElementById('home-view').style.display='none'; document.getElementById('profile-view').style.display='block';\n                navs[0].classList.remove('active'); navs[1].classList.add('active');\n            }\n        };\n\n        window.openEditModal = () => {\n            document.getElementById('edit-modal').style.display='flex';\n            document.getElementById('edit-name').value = auth.currentUser.displayName || '';\n            document.getElementById('edit-pic').value = auth.currentUser.photoURL || '';\n        };\n\n        window.saveProfile = async () => {\n            const name = document.getElementById('edit-name').value;\n            const pic = document.getElementById('edit-pic').value;\n            try {\n                await updateProfile(auth.currentUser, {displayName: name, photoURL: pic});\n                updateUserUI(auth.currentUser);\n                document.getElementById('edit-modal').style.display='none';\n                showToast(\"Profile Updated!\");\n            } catch(e) { showToast(e.message, 'error'); }\n        };\n    <\/script>\n<\/body>\n<\/html>","icon":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/bAEMADQkKCwoIDQsKCw4ODQ8TIBUTEhITJxweFyAuKTEwLiktLDM6Sj4zNkY3LC1AV0FGTE5SU1IyPlphWlBgSlFST\/\/bAEMBDg4OExETJhUVJk81LTVPT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT\/\/AABEIAGAAYAMBIgACEQEDEQH\/xAAaAAADAQEBAQAAAAAAAAAAAAAAAQMCBAUG\/8QALBAAAgICAQMACAcAAAAAAAAAAAECAwQRMRIhQQUTMlFhcYGRQlNykqKxwf\/EABgBAAMBAQAAAAAAAAAAAAAAAAABAgME\/8QAHhEBAQACAgIDAAAAAAAAAAAAAAECERIhA0ETMVH\/2gAMAwEAAhED