{"code":"<!DOCTYPE html>\n<html lang=\"bn\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Ultimate HTML to APK Studio<\/title>\n    \n    <!-- ফন্ট এবং আইকন লাইব্রেরি -->\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.0\/css\/all.min.css\">\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=JetBrains+Mono:wght@400;700&family=Poppins:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n    \n    <!-- জিপ ফাইল তৈরির জন্য লাইব্রেরি -->\n    <script src=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/jszip\/3.10.1\/jszip.min.js\"><\/script>\n    <script src=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/FileSaver.js\/2.0.5\/FileSaver.min.js\"><\/script>\n\n    <style>\n        :root {\n            --primary: #00E676; \/* Android Green *\/\n            --primary-dark: #00C853;\n            --bg-dark: #121212;\n            --bg-panel: #1E1E1E;\n            --text-main: #FFFFFF;\n            --text-muted: #B0BEC5;\n            --accent: #2979FF;\n        }\n\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        \n        body {\n            background-color: var(--bg-dark);\n            color: var(--text-main);\n            font-family: 'Poppins', sans-serif;\n            height: 100vh;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n        }\n\n        \/* --- ১. হেডার সেকশন --- *\/\n        header {\n            background-color: var(--bg-panel);\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 0 20px;\n            border-bottom: 1px solid #333;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.3);\n        }\n\n        .brand {\n            font-size: 1.2rem;\n            font-weight: 600;\n            color: var(--primary);\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        .toolbar {\n            display: flex;\n            gap: 15px;\n        }\n\n        .tool-btn {\n            background: #2C2C2C;\n            border: 1px solid #444;\n            color: white;\n            padding: 8px 15px;\n            border-radius: 5px;\n            cursor: pointer;\n            transition: 0.3s;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            font-size: 0.9rem;\n        }\n\n        .tool-btn:hover { background: #444; border-color: var(--primary); }\n        \n        .btn-download {\n            background: linear-gradient(135deg, var(--primary), var(--primary-dark));\n            border: none;\n            color: #000;\n            font-weight: bold;\n        }\n        \n        .btn-download:hover { transform: scale(1.05); box-shadow: 0 0 10px rgba(0, 230, 118, 0.4); }\n\n        \/* --- ২. এডিটর এরিয়া --- *\/\n        #editor-container {\n            flex: 1;\n            display: flex;\n            position: relative;\n        }\n\n        .line-numbers {\n            width: 40px;\n            background: #181818;\n            color: #555;\n            text-align: right;\n            padding: 15px 5px;\n            font-family: 'JetBrains Mono', monospace;\n            font-size: 14px;\n            border-right: 1px solid #333;\n            user-select: none;\n        }\n\n        textarea#htmlCode {\n            flex: 1;\n            background: #181818;\n            color: #e0e0e0;\n            border: none;\n            padding: 15px;\n            font-family: 'JetBrains Mono', monospace;\n            font-size: 14px;\n            line-height: 1.5;\n            resize: none;\n            outline: none;\n        }\n\n        \/* --- ৩. প্রিভিউ মোড (Full Screen) --- *\/\n        #preview-modal {\n            position: fixed;\n            top: 0; left: 0; width: 100%; height: 100%;\n            background: white;\n            z-index: 100;\n            display: none;\n            flex-direction: column;\n        }\n        \n        .preview-bar {\n            background: #333;\n            color: white;\n            padding: 10px;\n            text-align: right;\n        }\n\n        .close-preview-btn {\n            background: #ff4757;\n            border: none;\n            color: white;\n            padding: 5px 15px;\n            cursor: pointer;\n            border-radius: 4px;\n        }\n\n        iframe#previewFrame {\n            flex: 1;\n            border: none;\n            width: 100%;\n        }\n\n        \/* --- ৪. কনফিগারেশন পেজ (APK Settings) --- *\/\n        #config-modal {\n            position: fixed;\n            top: 0; left: 0; width: 100%; height: 100%;\n            background: rgba(0,0,0,0.85);\n            backdrop-filter: blur(5px);\n            z-index: 200;\n            display: none;\n            justify-content: center;\n            align-items: center;\n        }\n\n        .config-card {\n            background: var(--bg-panel);\n            width: 90%;\n            max-width: 500px;\n            border-radius: 12px;\n            padding: 25px;\n            border: 1px solid #444;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n            max-height: 90vh;\n            overflow-y: auto;\n        }\n\n        .config-title {\n            text-align: center;\n            font-size: 1.5rem;\n            margin-bottom: 20px;\n            color: var(--primary);\n        }\n\n        .form-group { margin-bottom: 15px; }\n        .form-group label { display: block; margin-bottom: 5px; color: var(--text-muted); font-size: 0.9rem; }\n        .form-control {\n            width: 100%; padding: 10px;\n            background: #2C2C2C; border: 1px solid #444;\n            border-radius: 6px; color: white;\n            font-family: inherit;\n        }\n        .form-control:focus { border-color: var(--primary); outline: none; }\n\n        \/* File Upload Styling *\/\n        .upload-box {\n            border: 2px dashed #444;\n            padding: 15px;\n            text-align: center;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: 0.2s;\n        }\n        .upload-box:hover { border-color: var(--primary); background: #252525; }\n        .upload-preview { max-width: 60px; max-height: 60px; margin-top: 10px; border-radius: 8px; display: none; }\n\n        \/* Toggles *\/\n        .toggle-row {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 10px 0;\n            border-bottom: 1px solid #333;\n        }\n        \n        .switch {\n            position: relative; display: inline-block; width: 44px; height: 24px;\n        }\n        .switch input { opacity: 0; width: 0; height: 0; }\n        .slider {\n            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;\n            background-color: #555; transition: .4s; border-radius: 34px;\n        }\n        .slider:before {\n            position: absolute; content: \"\"; height: 18px; width: 18px;\n            left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%;\n        }\n        input:checked + .slider { background-color: var(--primary); }\n        input:checked + .slider:before { transform: translateX(20px); }\n\n        \/* Action Buttons *\/\n        .btn-build {\n            width: 100%;\n            padding: 14px;\n            background: var(--primary);\n            color: #000;\n            border: none;\n            border-radius: 50px;\n            font-size: 1rem;\n            font-weight: bold;\n            cursor: pointer;\n            margin-top: 20px;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            gap: 10px;\n        }\n        .btn-cancel {\n            width: 100%;\n            background: transparent;\n            color: #888;\n            border: none;\n            padding: 10px;\n            cursor: pointer;\n            margin-top: 5px;\n        }\n\n        \/* --- ৫. লোডিং স্ক্রিন --- *\/\n        #loader {\n            position: fixed; inset: 0; background: rgba(0,0,0,0.95);\n            z-index: 300; display: none;\n            flex-direction: column; justify-content: center; align-items: center;\n        }\n        .loader-anim {\n            width: 60px; height: 60px;\n            border: 5px solid #333; border-top: 5px solid var(--primary);\n            border-radius: 50%; animation: spin 1s linear infinite;\n        }\n        @keyframes spin { 100% { transform: rotate(360deg); } }\n        .loader-text { margin-top: 20px; font-size: 1.2rem; color: var(--primary); }\n        .loader-sub { color: #777; font-size: 0.9rem; margin-top: 5px; }\n\n    <\/style>\n<\/head>\n<body>\n\n    <!-- হেডার -->\n    <header>\n        <div class=\"brand\">\n            <i class=\"fab fa-android fa-lg\"><\/i> APK Studio Pro\n        <\/div>\n        <div class=\"toolbar\">\n            <button class=\"tool-btn\" onclick=\"openPreview()\" title=\"Live Preview\">\n                <i class=\"fas fa-play\"><\/i> অ্যাপ রিভিউ\n            <\/button>\n            <button class=\"tool-btn btn-download\" onclick=\"openConfig()\" title=\"Export App\">\n                <i class=\"fas fa-download\"><\/i> ডাউনলোড\n            <\/button>\n        <\/div>\n    <\/header>\n\n    <!-- এডিটর -->\n    <div id=\"editor-container\">\n        <!-- লাইন নাম্বার (সিমুলেশন) -->\n        <div class=\"line-numbers\">1<br>2<br>3<br>4<br>5<br>6<br>7<br>8<br>9<br>10<\/div>\n        <!-- কোড ইনপুট -->\n        <textarea id=\"htmlCode\" spellcheck=\"false\" placeholder=\"আপনার HTML কোড এখানে লিখুন...\"><\/textarea>\n    <\/div>\n\n    <!-- প্রিভিউ স্ক্রিন -->\n    <div id=\"preview-modal\">\n        <div class=\"preview-bar\">\n            <button class=\"close-preview-btn\" onclick=\"closePreview()\">\n                <i class=\"fas fa-times\"><\/i> বন্ধ করুন\n            <\/button>\n        <\/div>\n        <iframe id=\"previewFrame\"><\/iframe>\n    <\/div>\n\n    <!-- কনফিগারেশন মোডাল -->\n    <div id=\"config-modal\">\n        <div class=\"config-card\">\n            <h3 class=\"config-title\">অ্যাপ কনফিগারেশন<\/h3>\n            \n            <div class=\"form-group\">\n                <label>অ্যাপের নাম (App Name)<\/label>\n                <input type=\"text\" id=\"appName\" class=\"form-control\" value=\"MyApp\">\n            <\/div>\n\n            <div class=\"form-group\">\n                <label>প্যাকেজ নেম (Ex: com.my.app)<\/label>\n                <input type=\"text\" id=\"pkgName\" class=\"form-control\" value=\"com.user.app\">\n            <\/div>\n\n            <div class=\"form-group\">\n                <label>অ্যাপ আইকন (512x512)<\/label>\n                <div class=\"upload-box\" onclick=\"document.getElementById('iconFile').click()\">\n                    <i class=\"fas fa-image\"><\/i> ছবি আপলোড করুন\n                    <input type=\"file\" id=\"iconFile\" hidden accept=\"image\/*\" onchange=\"handleImage(this, 'iconPreview')\">\n                    <img id=\"iconPreview\" class=\"upload-preview\">\n                <\/div>\n            <\/div>\n\n            <!-- অ্যাডভান্সড ফিচার টগল -->\n            <div style=\"margin-top: 20px;\">\n                <label style=\"color: var(--primary); font-weight: bold; font-size: 0.8rem;\">ফিচারস এবং পারমিশন<\/label>\n                \n                <div class=\"toggle-row\">\n                    <span>ছবি\/ভিডিও ডাউনলোড (Gallery)<\/span>\n                    <label class=\"switch\"><input type=\"checkbox\" id=\"featDl\"><span class=\"slider\"><\/span><\/label>\n                <\/div>\n                <div class=\"toggle-row\">\n                    <span>ক্যামেরা অ্যাক্সেস<\/span>\n                    <label class=\"switch\"><input type=\"checkbox\" id=\"featCam\"><span class=\"slider\"><\/span><\/label>\n                <\/div>\n                <div class=\"toggle-row\">\n                    <span>ইন্টারনেট পারমিশন<\/span>\n                    <label class=\"switch\"><input type=\"checkbox\" id=\"featNet\" checked disabled><span class=\"slider\"><\/span><\/label>\n                <\/div>\n            <\/div>\n\n            <button class=\"btn-build\" onclick=\"startBuild()\">\n                <i class=\"fas fa-cog\"><\/i> অ্যাপ তৈরি করুন\n            <\/button>\n            <button class=\"btn-cancel\" onclick=\"closeConfig()\">বাতিল করুন<\/button>\n        <\/div>\n    <\/div>\n\n    <!-- লোডার -->\n    <div id=\"loader\">\n        <div class=\"loader-anim\"><\/div>\n        <div class=\"loader-text\">APK প্রসেস করা হচ্ছে...<\/div>\n        <div class=\"loader-sub\" id=\"loaderStatus\">কোড কম্পাইল হচ্ছে<\/div>\n    <\/div>\n\n    <script>\n        \/\/ ডিফল্ট কোড সেট করা\n        const defaultCode = `<!DOCTYPE html>\n<html>\n<head>\n    <title>My App<\/title>\n    <style>\n        body { \n            background: #1e1e1e; \n            color: white; \n            font-family: sans-serif; \n            display: flex; \n            flex-direction: column;\n            align-items: center; \n            justify-content: center; \n            height: 100vh; \n            margin: 0;\n        }\n        button {\n            background: #00E676;\n            border: none;\n            padding: 15px 30px;\n            border-radius: 50px;\n            font-size: 18px;\n            font-weight: bold;\n            color: black;\n            cursor: pointer;\n            margin-top: 20px;\n        }\n        img { width: 100px; margin-bottom: 20px; }\n    <\/style>\n<\/head>\n<body>\n    <img src=\"https:\/\/cdn-icons-png.flaticon.com\/512\/732\/732205.png\" alt=\"Icon\">\n    <h1>স্বাগতম!<\/h1>\n    <p>এটি আপনার নিজের অ্যাপ।<\/p>\n    <button onclick=\"downloadTest()\">একটি ছবি ডাউনলোড করুন<\/button>\n\n    <script>\n        function downloadTest() {\n            alert('ডাউনলোড ফিচারটি অ্যাপ বিল্ড করার পর কাজ করবে!');\n        }\n    <\\\/script>\n<\/body>\n<\/html>`;\n        \n        document.getElementById('htmlCode').value = defaultCode;\n\n        \/\/ UI কন্ট্রোল ফাংশন\n        function openPreview() {\n            const code = document.getElementById('htmlCode').value;\n            const frame = document.getElementById('previewFrame');\n            document.getElementById('preview-modal').style.display = 'flex';\n            \n            const doc = frame.contentWindow.document;\n            doc.open();\n            doc.write(code);\n            doc.close();\n        }\n\n        function closePreview() {\n            document.getElementById('preview-modal').style.display = 'none';\n        }\n\n        function openConfig() {\n            document.getElementById('config-modal').style.display = 'flex';\n        }\n\n        function closeConfig() {\n            document.getElementById('config-modal').style.display = 'none';\n        }\n\n        \/\/ ছবি প্রিভিউ হ্যান্ডলার\n        function handleImage(input, imgId) {\n            if (input.files && input.files[0]) {\n                const reader = new FileReader();\n                reader.onload = function(e) {\n                    const img = document.getElementById(imgId);\n                    img.src = e.target.result;\n                    img.style.display = 'block';\n                }\n                reader.readAsDataURL(input.files[0]);\n            }\n        }\n\n        \/\/ --- APK বিল্ড লজিক (Simulated Realism) ---\n        function startBuild() {\n            const appName = document.getElementById('appName').value || \"MyApp\";\n            \n            \/\/ ১. কনফিগারেশন বন্ধ করে লোডার চালু\n            closeConfig();\n            const loader = document.getElementById('loader');\n            const status = document.getElementById('loaderStatus');\n            loader.style.display = 'flex';\n\n            \/\/ ২. ফেইক প্রসেসিং টাইমলাইন (Pro ভাব আনার জন্য)\n            const steps = [\n                { time: 1000, text: \"HTML\/CSS পার্স করা হচ্ছে...\" },\n                { time: 2500, text: \"জাভাস্ক্রিপ্ট অপ্টিমাইজ করা হচ্ছে...\" },\n                { time: 4000, text: \"অ্যান্ড্রয়েড ম্যানিফেস্ট তৈরি হচ্ছে...\" },\n                { time: 5500, text: \"রিসোর্স এবং আইকন প্যাক করা হচ্ছে...\" },\n                { time: 7000, text: \"APK প্যাকেজ সাইন করা হচ্ছে...\" }\n            ];\n\n            let currentStep = 0;\n            const interval = setInterval(() => {\n                if (currentStep < steps.length) {\n                    status.innerText = steps[currentStep].text;\n                    currentStep++;\n                } else {\n                    clearInterval(interval);\n                    generatePackage(appName);\n                }\n            }, 1200);\n        }\n\n        \/\/ --- আসল ZIP জেনারেশন ---\n        function generatePackage(appName) {\n            const zip = new JSZip();\n            let htmlContent = document.getElementById('htmlCode').value;\n\n            \/\/ ফিচার ইনজেকশন: যদি ইউজার ডাউনলোড পারমিশন চায়\n            if (document.getElementById('featDl').checked) {\n                const downloadScript = `\n                <script>\n                \/\/ Auto-injected Download Helper\n                function downloadFile(url) {\n                    const a = document.createElement('a');\n                    a.href = url;\n                    a.download = '';\n                    document.body.appendChild(a);\n                    a.click();\n                    document.body.removeChild(a);\n                }\n                <\\\/script>`;\n                \/\/ <\/body> এর আগে স্ক্রিপ্ট বসিয়ে দেওয়া\n                htmlContent = htmlContent.replace('<\/body>', downloadScript + '\\n<\/body>');\n            }\n\n            \/\/ ফাইলগুলো জিপে ভরা\n            zip.file(\"index.html\", htmlContent);\n            \n            \/\/ কনফিগ ফাইল (Web2APK সফটওয়্যার বা PWA এর জন্য)\n            const configData = {\n                appName: appName,\n                packageName: document.getElementById('pkgName').value,\n                version: \"1.0.0\",\n                permissions: {\n                    camera: document.getElementById('featCam').checked,\n                    storage: document.getElementById('featDl').checked\n                }\n            };\n            zip.file(\"app_config.json\", JSON.stringify(configData, null, 2));\n            \n            \/\/ রিডমি ফাইল (ইউজার গাইড)\n            zip.file(\"README_FOR_APK.txt\", \n`IMPORTANT: How to get your .APK file\n=====================================\nআপনার অ্যাপ সোর্স কোড তৈরি হয়ে গেছে!\n\nব্রাউজার থেকে সরাসরি .apk ফাইল তৈরি করা প্রযুক্তিগতভাবে সম্ভব নয়।\nতবে আপনার কাজ ৯০% হয়ে গেছে। এখন শুধু নিচের ধাপ অনুসরণ করুন:\n\n১. এই ফোল্ডারের \"index.html\" ফাইলটি নিন।\n২. আপনার কম্পিউটারে \"Website 2 APK Builder\" (ফ্রি সফটওয়্যার) খুলুন।\n৩. \"Local HTML Website\" সিলেক্ট করে এই index.html ফাইলটি দেখিয়ে দিন।\n৪. \"Generate APK\" বাটনে চাপ দিন।\n\nব্যাস! আপনার আসল APK তৈরি হয়ে যাবে।`);\n\n            \/\/ আইকন থাকলে জিপে ঢোকানো\n            const iconInput = document.getElementById('iconFile');\n            if (iconInput.files[0]) {\n                zip.file(\"icon.png\", iconInput.files[0]);\n            }\n\n            \/\/ জিপ ডাউনলোড করা\n            zip.generateAsync({type:\"blob\"}).then(function(content) {\n                document.getElementById('loader').style.display = 'none';\n                \n                \/\/ ফাইলের নাম .zip দেওয়া হচ্ছে যাতে করাপ্ট না হয়\n                \/\/ ইউজারকে আমরা বলে দেব এটাই সোর্স ফাইল\n                saveAs(content, appName + \"_Source_Code.zip\");\n                \n                alert(\"আপনার অ্যাপ প্যাকেজ রেডি! \\n\\n'\"+ appName +\"_Source_Code.zip' ফাইলটি ডাউনলোড ফোল্ডারে চেক করুন।\\n\\n(Zip ফাইলটি আনজিপ করে README ফাইলটি পড়ুন APK পাওয়ার জন্য।)\");\n            });\n        }\n    <\/script>\n<\/body>\n<\/html>","icon":"null","splash":"null","app_name":"htmlwev","package_name":"com.htmgglghjjhgjbu.app","version_name":"1.0.0","version_code":"1","use_camera":false,"use_mic":false,"use_storage":true,"use_location":false,"status_bar_color":"dynamic","use_dynamic":true,"use_security":true,"use_fullscreen":true,"use_notification":false,"use_block_screenshot":true,"screen_orientation":"default","use_double_back_exit":false,"use_back_nav":false,"use_keep_screen_on":true,"use_offline_page":false,"use_file_download":true,"use_bg_audio":false}