{"code":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Xtr Developer Console Pro<\/title>\n    <!-- Fonts & Icons -->\n    <link href=\"https:\/\/fonts.googleapis.com\/icon?family=Material+Icons+Round\" rel=\"stylesheet\">\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        :root {\n            --primary: #2563eb;\n            --primary-dark: #1e40af;\n            --secondary: #64748b;\n            --bg-body: #f1f5f9;\n            --bg-surface: #ffffff;\n            --sidebar-width: 300px; \n            --text-main: #1e293b;\n            --text-muted: #64748b;\n            --border: #e2e8f0;\n            --success: #10b981;\n            --error: #ef4444;\n            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n        }\n\n        * { box-sizing: border-box; outline: none; }\n        \n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: var(--bg-body);\n            margin: 0; padding: 0;\n            color: var(--text-main);\n            height: 100vh;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n        }\n\n        \/* --- NOTIFICATION TOAST --- *\/\n        #toast-container {\n            position: fixed; top: 20px; right: 20px; z-index: 9999;\n            display: flex; flex-direction: column; gap: 10px;\n        }\n        .toast {\n            background: var(--bg-surface); padding: 16px 20px;\n            border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.15);\n            display: flex; align-items: center; min-width: 300px;\n            border-left: 5px solid var(--primary);\n            animation: slideIn 0.3s ease-out forwards;\n            font-size: 14px; font-weight: 500;\n        }\n        .toast.success { border-color: var(--success); }\n        .toast.error { border-color: var(--error); }\n        .toast i { margin-right: 12px; font-size: 20px; }\n        \n        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }\n        @keyframes fadeOut { to { opacity: 0; transform: translateY(-10px); } }\n\n        \/* --- LOGIN SCREEN --- *\/\n        #loginScreen {\n            position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n            background: var(--bg-body); z-index: 2000;\n            display: flex; flex-direction: column; align-items: center; justify-content: center;\n        }\n        .login-card {\n            background: var(--bg-surface); padding: 40px; border-radius: 20px;\n            box-shadow: var(--shadow); text-align: center; width: 90%; max-width: 400px;\n        }\n        .x-btn {\n            background: #000; color: #fff; width: 100%; padding: 15px;\n            border-radius: 12px; cursor: pointer; font-weight: 600; margin-top: 20px;\n            display: flex; align-items: center; justify-content: center; gap: 10px;\n            transition: transform 0.2s;\n        }\n        .x-btn:active { transform: scale(0.98); }\n\n        \/* --- DASHBOARD LAYOUT --- *\/\n        #dashboardScreen { display: none; width: 100%; height: 100%; flex-direction: column; position: relative; }\n\n        \/* Top Navigation Bar *\/\n        .top-nav {\n            height: 60px; background: var(--bg-surface);\n            border-bottom: 1px solid var(--border);\n            display: flex; align-items: center; padding: 0 20px;\n            flex-shrink: 0; z-index: 100;\n            box-shadow: 0 2px 5px rgba(0,0,0,0.02);\n        }\n        .menu-btn {\n            cursor: pointer; padding: 8px; border-radius: 8px;\n            margin-right: 15px; color: var(--text-main);\n            transition: background 0.2s;\n        }\n        .menu-btn:hover { background: #f1f5f9; }\n        .nav-brand { font-weight: 800; font-size: 20px; color: var(--primary); display: flex; align-items: center; gap: 8px; }\n\n        \/* Sidebar (Drawer Style) *\/\n        .sidebar-overlay {\n            position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n            background: rgba(0,0,0,0.4); z-index: 998;\n            opacity: 0; visibility: hidden; transition: 0.3s;\n        }\n        .sidebar-overlay.active { opacity: 1; visibility: visible; }\n\n        .sidebar {\n            position: fixed; top: 0; left: -100%; \/* Hidden initially *\/\n            width: var(--sidebar-width); height: 100%;\n            background: var(--bg-surface); z-index: 999;\n            box-shadow: 5px 0 25px rgba(0,0,0,0.1);\n            transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            display: flex; flex-direction: column; padding: 24px;\n        }\n        .sidebar.active { left: 0; }\n\n        .sidebar-header {\n            display: flex; justify-content: space-between; align-items: center;\n            margin-bottom: 40px;\n        }\n        .close-menu-btn {\n            cursor: pointer; padding: 8px; border-radius: 50%;\n            background: #f1f5f9; color: var(--text-main);\n            transition: 0.2s;\n        }\n        .close-menu-btn:hover { background: #e2e8f0; color: var(--error); }\n\n        .nav-item {\n            display: flex; align-items: center; padding: 14px 16px;\n            color: var(--text-muted); border-radius: 12px; cursor: pointer;\n            margin-bottom: 8px; transition: all 0.2s; font-weight: 500;\n        }\n        .nav-item:hover, .nav-item.active { background: #eff6ff; color: var(--primary); }\n        .nav-item i { margin-right: 12px; }\n\n        .user-profile {\n            margin-top: auto; padding-top: 20px; border-top: 1px solid var(--border);\n            display: flex; align-items: center; gap: 12px;\n        }\n        .avatar {\n            width: 40px; height: 40px; background: var(--primary); color: white;\n            border-radius: 50%; display: flex; align-items: center; justify-content: center;\n            font-weight: bold; font-size: 16px;\n        }\n\n        \/* Content Area (Full Screen) *\/\n        .content-area {\n            flex-grow: 1; overflow-y: auto; padding: 30px;\n            background: var(--bg-body); position: relative;\n            width: 100%;\n        }\n\n        \/* --- VIEWS --- *\/\n        .view-section { display: none; width: 100%; max-width: 1200px; margin: 0 auto; }\n        .view-section.active-view { display: block; animation: fadeIn 0.4s ease; }\n\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n\n        .page-header { margin-bottom: 30px; }\n        .page-title { font-size: 28px; font-weight: 700; color: var(--text-main); margin: 0; }\n        .page-subtitle { color: var(--text-muted); margin-top: 5px; }\n\n        \/* Form Styles *\/\n        .card {\n            background: var(--bg-surface); border-radius: 16px; padding: 30px;\n            box-shadow: var(--shadow); border: 1px solid var(--border);\n        }\n        \n        .input-group { margin-bottom: 20px; }\n        .label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--text-main); }\n        .input-field {\n            width: 100%; padding: 14px; border-radius: 10px;\n            border: 1px solid var(--border); background: #f8fafc;\n            font-family: 'Inter', sans-serif; font-size: 15px;\n            transition: 0.2s;\n        }\n        .input-field:focus { border-color: var(--primary); background: #fff; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }\n        \n        .code-editor {\n            font-family: 'Courier New', monospace; height: 300px;\n            background: #1e293b; color: #e2e8f0; border: none;\n        }\n\n        \/* Progress Button *\/\n        .submit-container { margin-top: 30px; }\n        .progress-btn {\n            width: 100%; height: 56px; border-radius: 12px;\n            background: var(--bg-body); border: 2px solid var(--border);\n            position: relative; overflow: hidden; cursor: pointer;\n            display: flex; align-items: center; justify-content: center;\n            font-weight: 600; color: var(--text-main); font-size: 16px;\n            transition: 0.2s;\n        }\n        .progress-btn:hover { border-color: var(--primary); color: var(--primary); }\n        .progress-btn.processing { background: #f0f9ff; border-color: var(--primary); cursor: wait; }\n        \n        .btn-text { position: relative; z-index: 2; transition: color 0.2s; }\n        .progress-btn.processing .btn-text { color: var(--primary); }\n\n        \/* Manage Apps Grid (Responsive) *\/\n        .apps-grid { \n            display: grid; \n            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); \n            gap: 24px; \n        }\n        .app-card {\n            background: var(--bg-surface); border-radius: 16px; padding: 24px;\n            border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s;\n            position: relative; display: flex; flex-direction: column;\n        }\n        .app-card:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }\n        \n        .ac-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; }\n        .ac-icon { width: 56px; height: 56px; border-radius: 12px; object-fit: cover; background: #eee; }\n        .ac-meta h3 { margin: 0; font-size: 18px; font-weight: 600; }\n        .ac-status { font-size: 12px; padding: 4px 8px; border-radius: 20px; display: inline-block; margin-top: 4px; font-weight: 500; }\n        .status-pending { background: #fef3c7; color: #d97706; }\n        \n        .ac-actions {\n            border-top: 1px solid var(--border); padding-top: 15px; margin-top: auto;\n            display: flex; justify-content: space-between;\n        }\n        .action-btn {\n            border: none; background: none; cursor: pointer; font-size: 14px;\n            font-weight: 500; display: flex; align-items: center; gap: 6px;\n            padding: 8px 12px; border-radius: 8px;\n        }\n        .btn-delete { color: var(--error); }\n        .btn-delete:hover { background: #fee2e2; }\n        .btn-edit { color: var(--primary); }\n        .btn-edit:hover { background: #eff6ff; }\n\n        \/* Empty State *\/\n        .empty-state { text-align: center; padding: 50px; color: var(--text-muted); width: 100%; }\n        .empty-state i { font-size: 64px; margin-bottom: 15px; opacity: 0.5; display: block; margin: 0 auto 15px auto;}\n\n    <\/style>\n<\/head>\n<body>\n\n    <!-- Toast Container -->\n    <div id=\"toast-container\"><\/div>\n\n    <!-- SCREEN 1: LOGIN -->\n    <div id=\"loginScreen\">\n        <div class=\"login-card\">\n            <div style=\"font-size: 40px; font-weight: 800; background: linear-gradient(135deg, #2563eb, #9333ea); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 10px;\">Xtr Console<\/div>\n            <p style=\"color: var(--text-muted);\">Manage and publish your apps seamlessly.<\/p>\n            \n            <div id=\"accountList\" style=\"margin-top: 30px;\">\n                <!-- Accounts injected via JS -->\n            <\/div>\n            \n            <div class=\"x-btn\" onclick=\"simulateLogin()\">\n                <span style=\"font-size: 20px; font-weight:bold;\">X<\/span> Continue with Xtr ID\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- SCREEN 2: DASHBOARD -->\n    <div id=\"dashboardScreen\">\n        \n        <!-- Top Nav with Hamburger -->\n        <div class=\"top-nav\">\n            <div class=\"menu-btn\" onclick=\"toggleSidebar()\">\n                <span class=\"material-icons-round\" style=\"font-size: 28px;\">menu<\/span>\n            <\/div>\n            <div class=\"nav-brand\">\n                <span class=\"material-icons-round\" style=\"color:var(--primary)\">terminal<\/span> Xtr Console\n            <\/div>\n        <\/div>\n\n        <!-- Sidebar Overlay (for clicking outside to close) -->\n        <div class=\"sidebar-overlay\" onclick=\"toggleSidebar()\"><\/div>\n\n        <!-- Sidebar (Drawer) -->\n        <div class=\"sidebar\" id=\"sidebar\">\n            <div class=\"sidebar-header\">\n                <div style=\"font-size: 20px; font-weight: 800; color: var(--primary);\">Menu<\/div>\n                <div class=\"close-menu-btn\" onclick=\"toggleSidebar()\">\n                    <span class=\"material-icons-round\">close<\/span>\n                <\/div>\n            <\/div>\n            \n            <div class=\"nav-item active\" onclick=\"switchView('publish')\">\n                <span class=\"material-icons-round\">add_box<\/span> Publish App\n            <\/div>\n            <div class=\"nav-item\" onclick=\"switchView('manage')\">\n                <span class=\"material-icons-round\">grid_view<\/span> Manage Apps\n            <\/div>\n\n            <div class=\"user-profile\">\n                <div class=\"avatar\" id=\"dashAvatar\">U<\/div>\n                <div>\n                    <div style=\"font-weight: 600; font-size: 14px;\" id=\"dashName\">User Name<\/div>\n                    <div style=\"font-size: 12px; color: var(--text-muted);\">Developer<\/div>\n                <\/div>\n            <\/div>\n        <\/div>\n\n        <!-- Content Area (Full Screen) -->\n        <div class=\"content-area\">\n            \n            <!-- VIEW: PUBLISH APP -->\n            <div id=\"view-publish\" class=\"view-section active-view\">\n                <div class=\"page-header\">\n                    <h1 class=\"page-title\">Publish New App<\/h1>\n                    <div class=\"page-subtitle\">Submit your application to the Xtr Ecosystem.<\/div>\n                <\/div>\n\n                <div class=\"card\">\n                    <div class=\"input-group\">\n                        <label class=\"label\">Application Name<\/label>\n                        <input type=\"text\" class=\"input-field\" id=\"appName\" placeholder=\"e.g. Super Note\">\n                    <\/div>\n                    <div class=\"input-group\">\n                        <label class=\"label\">Icon URL<\/label>\n                        <input type=\"text\" class=\"input-field\" id=\"appIcon\" placeholder=\"https:\/\/example.com\/icon.png\">\n                    <\/div>\n                    <div class=\"input-group\">\n                        <label class=\"label\">Short Description<\/label>\n                        <input type=\"text\" class=\"input-field\" id=\"appDesc\" placeholder=\"A brief overview of your app\">\n                    <\/div>\n                    <div class=\"input-group\">\n                        <label class=\"label\">Source Code (HTML\/CSS\/JS)<\/label>\n                        <textarea class=\"input-field code-editor\" id=\"appCode\" spellcheck=\"false\" placeholder=\"Paste your full HTML code here...\"><\/textarea>\n                    <\/div>\n\n                    <div class=\"submit-container\">\n                        <div class=\"progress-btn\" id=\"submitBtn\" onclick=\"startSubmission()\">\n                            <span class=\"btn-text\" id=\"btnText\">Submit for Review<\/span>\n                        <\/div>\n                    <\/div>\n                <\/div>\n            <\/div>\n\n            <!-- VIEW: MANAGE APPS -->\n            <div id=\"view-manage\" class=\"view-section\">\n                <div class=\"page-header\">\n                    <h1 class=\"page-title\">Manage Apps<\/h1>\n                    <div class=\"page-subtitle\">View, edit or delete your submitted applications.<\/div>\n                <\/div>\n\n                <div id=\"appsListContainer\" class=\"apps-grid\">\n                    <!-- Loaded dynamically -->\n                    <div class=\"empty-state\">\n                        <i class=\"material-icons-round\">hourglass_empty<\/i>\n                        <p>Loading your apps...<\/p>\n                    <\/div>\n                <\/div>\n            <\/div>\n\n        <\/div>\n    <\/div>\n\n<script type=\"module\">\n    import { initializeApp } from \"https:\/\/www.gstatic.com\/firebasejs\/9.6.1\/firebase-app.js\";\n    import { getFirestore, collection, addDoc, query, where, getDocs, deleteDoc, doc } from \"https:\/\/www.gstatic.com\/firebasejs\/9.6.1\/firebase-firestore.js\";\n\n    \/\/ Firebase Config\n    const firebaseConfig = {\n        apiKey: \"AIzaSyClgZafPZJsUWFHb_OylK7ldIVgZ42bWAs\",\n        authDomain: \"broger-de7f1.firebaseapp.com\",\n        projectId: \"broger-de7f1\",\n        storageBucket: \"broger-de7f1.firebasestorage.app\",\n        messagingSenderId: \"115136426131\",\n        appId: \"1:115136426131:web:42c33cf2be4bed03611d66\"\n    };\n\n    const app = initializeApp(firebaseConfig);\n    const db = getFirestore(app);\n\n    let currentUser = null;\n\n    \/\/ --- 1. UI LOGIC ---\n    window.toggleSidebar = function() {\n        const sidebar = document.getElementById('sidebar');\n        const overlay = document.querySelector('.sidebar-overlay');\n        sidebar.classList.toggle('active');\n        overlay.classList.toggle('active');\n    }\n\n    \/\/ --- 2. TOAST SYSTEM ---\n    window.showToast = function(msg, type = 'normal') {\n        const container = document.getElementById('toast-container');\n        const toast = document.createElement('div');\n        toast.className = `toast ${type}`;\n        \n        let icon = 'info';\n        if(type === 'success') icon = 'check_circle';\n        if(type === 'error') icon = 'error';\n\n        toast.innerHTML = `<i class=\"material-icons-round\">${icon}<\/i> ${msg}`;\n        container.appendChild(toast);\n\n        setTimeout(() => {\n            toast.style.animation = 'fadeOut 0.3s forwards';\n            setTimeout(() => toast.remove(), 300);\n        }, 4000);\n    }\n\n    \/\/ --- 3. AUTH & PERSISTENCE (FIXED FOR UNDEFINED ID) ---\n    window.onload = function() {\n        const storedUser = localStorage.getItem('xtrUser');\n        if (storedUser) {\n            let parsedUser = JSON.parse(storedUser);\n            \/\/ Fix for old data: if uid is missing, add it\n            if (!parsedUser.uid) {\n                parsedUser.uid = \"user_\" + Date.now();\n                localStorage.setItem('xtrUser', JSON.stringify(parsedUser));\n            }\n            login(parsedUser);\n        }\n    };\n\n    window.simulateLogin = function() {\n        let user = JSON.parse(localStorage.getItem('xtrUser'));\n        if(!user) {\n            user = {\n                fullName: \"Demo Developer\",\n                shortName: \"Dev\",\n                email: \"dev@xtr.com\",\n                uid: \"user_\" + Date.now() \/\/ Ensure UID exists\n            };\n            localStorage.setItem('xtrUser', JSON.stringify(user));\n        } else if (!user.uid) {\n            \/\/ Fix existing user without UID\n            user.uid = \"user_\" + Date.now();\n            localStorage.setItem('xtrUser', JSON.stringify(user));\n        }\n        login(user);\n    }\n\n    function login(user) {\n        currentUser = user;\n        document.getElementById('loginScreen').style.display = 'none';\n        document.getElementById('dashboardScreen').style.display = 'flex';\n        \n        document.getElementById('dashName').innerText = user.fullName;\n        document.getElementById('dashAvatar').innerText = user.fullName.charAt(0).toUpperCase();\n        \n        showToast(`Welcome back, ${user.shortName}!`, 'success');\n    }\n\n    \/\/ --- 4. NAVIGATION ---\n    window.switchView = function(viewName) {\n        if(window.innerWidth < 800) {\n            const sidebar = document.getElementById('sidebar');\n            if(sidebar.classList.contains('active')) toggleSidebar();\n        }\n\n        document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));\n        if(viewName === 'publish') document.querySelectorAll('.nav-item')[0].classList.add('active');\n        if(viewName === 'manage') document.querySelectorAll('.nav-item')[1].classList.add('active');\n\n        document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active-view'));\n        document.getElementById(`view-${viewName}`).classList.add('active-view');\n\n        if(viewName === 'manage') {\n            loadMyApps();\n        }\n    }\n\n    \/\/ --- 5. PUBLISH APP LOGIC (ROBUST DATA HANDLING) ---\n    window.startSubmission = async function() {\n        const name = document.getElementById('appName').value.trim();\n        const code = document.getElementById('appCode').value.trim();\n        const icon = document.getElementById('appIcon').value.trim();\n        const desc = document.getElementById('appDesc').value.trim();\n        \n        const btn = document.getElementById('submitBtn');\n        const txt = document.getElementById('btnText');\n\n        if (!name || !code) {\n            showToast(\"App Name and Source Code are required\", \"error\");\n            return;\n        }\n\n        if (btn.classList.contains('processing')) return;\n\n        \/\/ Visual Feedback\n        btn.classList.add('processing');\n        txt.innerText = \"Submitting...\";\n\n        \/\/ Call Firebase directly\n        await submitToFirebase(name, icon, desc, code);\n    }\n\n    async function submitToFirebase(name, icon, desc, code) {\n        if (!currentUser) {\n            showToast(\"User not logged in!\", \"error\");\n            return;\n        }\n\n        \/\/ Ensure UID is present, fallback if somehow still missing\n        const devId = currentUser.uid || (\"user_\" + Date.now());\n\n        \/\/ Safe Data Object (No undefined values)\n        const appData = {\n            name: name,\n            icon: icon || \"\", \n            desc: desc || \"\",\n            code: code,\n            developer: currentUser.email || \"unknown@xtr.com\",\n            developerId: devId, \n            timestamp: new Date().toISOString(),\n            status: 'pending'\n        };\n\n        console.log(\"Sending data to pendingApps:\", appData);\n\n        try {\n            const docRef = await addDoc(collection(db, \"pendingApps\"), appData);\n            console.log(\"Success! ID:\", docRef.id);\n\n            \/\/ Reset UI\n            document.getElementById('appName').value = '';\n            document.getElementById('appCode').value = '';\n            document.getElementById('appIcon').value = '';\n            document.getElementById('appDesc').value = '';\n\n            const btn = document.getElementById('submitBtn');\n            const txt = document.getElementById('btnText');\n\n            btn.classList.remove('processing');\n            txt.innerText = \"Submit for Review\";\n\n            showToast(\"App sent to review successfully!\", \"success\");\n\n        } catch (e) {\n            console.error(\"Submission Error:\", e);\n            \n            let errorMsg = \"Submission failed.\";\n            if (e.code === 'permission-denied') {\n                errorMsg = \"Permission Denied. Check Firestore Rules.\";\n            } else if (e.message.includes(\"undefined\")) {\n                errorMsg = \"Data Error: Some fields are missing.\";\n            } else {\n                errorMsg = \"Error: \" + e.message;\n            }\n\n            showToast(errorMsg, \"error\");\n            \n            \/\/ Reset Button on Error\n            const btn = document.getElementById('submitBtn');\n            const txt = document.getElementById('btnText');\n            btn.classList.remove('processing');\n            txt.innerText = \"Retry Submission\";\n        }\n    }\n\n    \/\/ --- 6. MANAGE APPS LOGIC ---\n    async function loadMyApps() {\n        const container = document.getElementById('appsListContainer');\n        container.innerHTML = '<div class=\"empty-state\"><i class=\"material-icons-round\">sync<\/i><p>Syncing data...<\/p><\/div>';\n\n        try {\n            const q = query(\n                collection(db, \"pendingApps\"), \n                where(\"developer\", \"==\", currentUser.email)\n            );\n            \n            const querySnapshot = await getDocs(q);\n            \n            if (querySnapshot.empty) {\n                container.innerHTML = `\n                    <div class=\"empty-state\">\n                        <i class=\"material-icons-round\">dashboard_customize<\/i>\n                        <p>You haven't published any apps yet.<\/p>\n                    <\/div>`;\n                return;\n            }\n\n            container.innerHTML = ''; \n\n            querySnapshot.forEach((docSnap) => {\n                const data = docSnap.data();\n                const appId = docSnap.id;\n                const displayIcon = data.icon ? data.icon : 'https:\/\/cdn-icons-png.flaticon.com\/512\/1006\/1006771.png';\n\n                const card = document.createElement('div');\n                card.className = 'app-card';\n                card.innerHTML = `\n                    <div class=\"ac-header\">\n                        <img src=\"${displayIcon}\" class=\"ac-icon\" onerror=\"this.src='https:\/\/cdn-icons-png.flaticon.com\/512\/1006\/1006771.png'\">\n                        <div class=\"ac-meta\">\n                            <h3>${data.name}<\/h3>\n                            <span class=\"ac-status status-pending\">Pending Review<\/span>\n                        <\/div>\n                    <\/div>\n                    <div style=\"font-size:13px; color:var(--text-muted); height:40px; overflow:hidden; text-overflow:ellipsis;\">\n                        ${data.desc || 'No description provided.'}\n                    <\/div>\n                    <div class=\"ac-actions\">\n                        <button class=\"action-btn btn-edit\" onclick=\"showToast('Edit feature coming soon!', 'normal')\">\n                            <i class=\"material-icons-round\" style=\"font-size:16px;\">edit<\/i> Edit\n                        <\/button>\n                        <button class=\"action-btn btn-delete\" onclick=\"deleteApp('${appId}')\">\n                            <i class=\"material-icons-round\" style=\"font-size:16px;\">delete<\/i> Delete\n                        <\/button>\n                    <\/div>\n                `;\n                container.appendChild(card);\n            });\n\n        } catch (e) {\n            console.error(\"Error loading apps:\", e);\n            container.innerHTML = '<div class=\"empty-state\" style=\"color:var(--error)\">Error loading apps. Check Console.<\/div>';\n        }\n    }\n\n    window.deleteApp = async function(docId) {\n        if(!confirm(\"Are you sure you want to delete this app?\")) return;\n\n        try {\n            await deleteDoc(doc(db, \"pendingApps\", docId));\n            showToast(\"App deleted successfully\", \"success\");\n            loadMyApps(); \n        } catch(e) {\n            console.error(\"Delete error:\", e);\n            showToast(\"Failed to delete app\", \"error\");\n        }\n    }\n<\/script>\n\n<\/body>\n<\/html>","icon":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/bAEMADQkKCwoIDQsKCw4ODQ8TIBUTEhITJxweFyAuKTEwLiktLDM6Sj4zNkY3LC1AV0FGTE5SU1IyPlphWlBgSlFST\/\/bAEMBDg4OExETJhUVJk81LTVPT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT\/\/AABEIAGAAYAMBIgACEQEDEQH\/xAAbAAEAAwEBAQEAAAAAAAAAAAAABQYHBAIBA\/\/EAEAQAAEDAgIDCA4LAQAAAAAAAAABAgMEEQUGEhMhBzFRcZGhwdIUIiMzQVJTYXOBgpPC4RUWFzI0NUNVY5Kx0f\/EABkBAQADAQEAAAAAAAAAAAAAAAABAgMFBP\/EACERAAMAAgEEAwEAAAAAAAAAAAABAgMRMQQSFCFBUaHh\/9oADAMBAAIRAxEAPwDMAAAAAAAAAAAAAAAAAAAAAAAAATGXsDXGZpNKXVQxW03Il1W\/gTkXaWdMlYT5et943qm0YLtbSMbzxD0ygA0FMk4T5et94zqn36j4Sv69b7xnVLeLk+inlYzPQTWZMBdgk8ejNrYJr6DlSyoqeBeVNpCmFS5embzSpbQABBYAAAFryHlqlx+qqZK579RSoy8bFsr1dfYq8FmrvbdqFUNH3Je9YrxxfGWlbZFPSJ9MIwvCG