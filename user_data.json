{"code":"<!DOCTYPE html>\n<html lang=\"en\" class=\"light\">\n<head>\n    <meta charset=\"UTF-8\">\n    <!-- Zoom disabled meta tag -->\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>A Bazardor app - Home<\/title>\n    <script src=\"https:\/\/cdn.tailwindcss.com\"><\/script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    colors: {\n                        darkBg: '#1a202c',\n                        darkCard: '#2d3748',\n                        darkText: '#e2e8f0'\n                    }\n                }\n            }\n        }\n    <\/script>\n    <style>\n        \/* Disable touch behaviors for zoom *\/\n        html, body {\n            touch-action: pan-x pan-y;\n            font-family: 'Segoe UI', sans-serif;\n            transition: background-color 0.3s, color 0.3s;\n            -webkit-user-select: none; \/* Safari *\/\n            -ms-user-select: none; \/* IE 10 and IE 11 *\/\n            user-select: none; \/* Standard syntax *\/\n        }\n        \n        .fade-in { animation: fadeIn 0.4s ease-in-out; }\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n        \n        .card-image-container:hover img { transform: scale(1.05); }\n        \n        \/* Scrollbar *\/\n        #notificationList::-webkit-scrollbar { width: 6px; }\n        #notificationList::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 4px; }\n\n        \/* Heart Animation *\/\n        .heart-icon { transition: color 0.3s, transform 0.2s; }\n        .heart-active { color: #ef4444 !important; transform: scale(1.2); }\n        \n        \/* Custom Back Button Style *\/\n        .back-button {\n            display: inline-flex;\n            align-items: center;\n            padding: 6px 12px;\n            border-radius: 9999px;\n            transition: all 0.2s ease-in-out;\n        }\n        .back-button:hover {\n            background-color: rgba(22, 163, 74, 0.1);\n        }\n        .dark .back-button:hover {\n            background-color: rgba(22, 163, 74, 0.2);\n        }\n\n        \/* Ad Banner Container *\/\n        .ad-container {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            background-color: #f3f4f6;\n            border-top: 1px solid #e5e7eb;\n            z-index: 40;\n        }\n        .dark .ad-container {\n            background-color: #1f2937;\n            border-color: #374151;\n        }\n    <\/style>\n<\/head>\n<body class=\"bg-[#f3f4f6] text-gray-800 dark:bg-gray-900 dark:text-gray-100 pb-36\">\n\n    <!-- Navbar -->\n    <nav class=\"bg-green-600 dark:bg-green-800 p-4 shadow-md sticky top-0 z-50 transition-colors\">\n        <div class=\"container mx-auto flex justify-between items-center text-white max-w-6xl\">\n            <h1 class=\"text-2xl font-bold cursor-pointer flex items-center gap-2\" onclick=\"showSection('home')\">\n                🛒 <span id=\"appTitle\">My Bazardor<\/span>\n            <\/h1>\n            \n            <!-- Updated Notification Icon -->\n            <div class=\"relative cursor-pointer group\" onclick=\"toggleNotifications()\">\n                <div class=\"p-2 group-hover:bg-green-700 rounded-full transition relative\">\n                    <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-7 w-7 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\" \/>\n                    <\/svg>\n                    <span id=\"notifBadge\" class=\"hidden absolute top-2 right-2 h-3 w-3 bg-red-500 rounded-full border-2 border-green-600 animate-pulse\"><\/span>\n                <\/div>\n            <\/div>\n        <\/div>\n    <\/nav>\n\n    <!-- Notification Modal -->\n    <div id=\"notificationModal\" class=\"hidden fixed top-16 right-2 md:right-10 z-[60] w-80 md:w-96 bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden fade-in\">\n        <div class=\"bg-green-50 dark:bg-gray-700 p-3 border-b border-green-100 dark:border-gray-600 flex justify-between items-center\">\n            <h3 class=\"font-bold text-green-800 dark:text-green-400\" id=\"lblNotifTitle\">Notifications<\/h3>\n            <button onclick=\"toggleNotifications()\" class=\"text-gray-500 hover:text-red-500 font-bold text-xl\">&times;<\/button>\n        <\/div>\n        <div id=\"notificationList\" class=\"max-h-96 overflow-y-auto p-2 bg-white dark:bg-gray-800\">\n            <p class=\"text-center text-gray-400 py-4 text-sm\">Loading...<\/p>\n        <\/div>\n    <\/div>\n\n    <!-- Offline Modal (Internet Check) -->\n    <div id=\"offlineModal\" class=\"hidden fixed inset-0 z-[100] bg-white dark:bg-gray-900 flex flex-col justify-center items-center p-6 text-center fade-in\">\n        <div class=\"w-40 h-40 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mb-6\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-20 w-20 text-red-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3m8.293 8.293l1.414 1.414\" \/>\n            <\/svg>\n        <\/div>\n        <h2 class=\"text-2xl font-bold text-gray-800 dark:text-white mb-2\">No Internet Connection<\/h2>\n        <p class=\"text-gray-500 dark:text-gray-400 mb-8 max-w-xs\">Please check your internet settings and try again.<\/p>\n        <button onclick=\"window.location.reload()\" class=\"bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition transform active:scale-95\">\n            Retry Connection\n        <\/button>\n    <\/div>\n\n    <!-- Main Content -->\n    <div class=\"container mx-auto p-4 mt-2 max-w-6xl\" onclick=\"closeNotificationsOutside(event)\">\n        \n        <!-- Home Section -->\n        <div id=\"homeSection\">\n            <div class=\"mb-8 mt-2 sticky top-20 z-40 bg-[#f3f4f6] dark:bg-gray-900 pb-2 transition-colors\">\n                <div class=\"relative\">\n                    <input type=\"text\" id=\"searchBar\" onkeyup=\"searchProducts()\" placeholder=\"Search products...\"\n                       class=\"w-full px-5 py-3 border-none rounded-full shadow-md focus:outline-none focus:ring-2 focus:ring-green-500 text-gray-700 bg-white dark:bg-gray-800 dark:text-white transition-colors\">\n                    <span class=\"absolute right-4 top-3 text-gray-400\">🔍<\/span>\n                <\/div>\n            <\/div>\n            \n            <div id=\"loader\" class=\"text-center mt-20\">\n                <div class=\"animate-spin rounded-full h-12 w-12 border-4 border-green-200 border-t-green-600 mx-auto\"><\/div>\n                <p class=\"mt-4 text-gray-500\" id=\"lblLoading\">Loading...<\/p>\n            <\/div>\n\n            <div id=\"productList\" class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 hidden\"><\/div>\n            \n            <div id=\"noResults\" class=\"hidden text-center mt-10\">\n                <p class=\"text-lg text-gray-500\">Sorry! No products found.<\/p>\n            <\/div>\n        <\/div>\n\n        <!-- Product Detail Section -->\n        <div id=\"productDetail\" class=\"hidden w-full max-w-3xl mx-auto fade-in pb-10\">\n            <button onclick=\"goBack()\" class=\"mb-4 back-button text-gray-600 dark:text-gray-300 hover:text-green-600 font-semibold\">\n                <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-5 w-5 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 19l-7-7 7-7\" \/>\n                <\/svg>\n                <span id=\"lblBack\">Go Back<\/span>\n            <\/button>\n            \n            <div class=\"bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden transition-colors\">\n                <img id=\"dImage\" src=\"\" alt=\"Product\" class=\"w-full h-72 md:h-96 object-cover\">\n                <div class=\"p-6 md:p-8\">\n                    <div class=\"flex justify-between items-start\">\n                        <div>\n                            <h2 id=\"dName\" class=\"text-3xl font-bold text-gray-800 dark:text-white mb-1\"><\/h2>\n                            <p class=\"text-sm text-gray-500 dark:text-gray-400\"><span id=\"lblUpdate\">Updated<\/span>: <span id=\"dDate\"><\/span><\/p>\n                        <\/div>\n                        <p class=\"text-3xl text-green-600 font-bold\">৳<span id=\"dPrice\"><\/span><\/p>\n                    <\/div>\n\n                    <div class=\"mt-6 border-t dark:border-gray-700 pt-6\">\n                        <h3 class=\"text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2\" id=\"lblDesc\">Description:<\/h3>\n                        <p id=\"dDesc\" class=\"text-gray-600 dark:text-gray-400 leading-relaxed whitespace-pre-line\"><\/p>\n                    <\/div>\n\n                    <div class=\"mt-8 pt-4 border-t dark:border-gray-700\">\n                        <button onclick=\"toggleFavoriteCurrent()\" class=\"w-full flex justify-center items-center gap-2 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-green-50 dark:hover:bg-gray-600 rounded-xl transition cursor-pointer\">\n                            <svg id=\"favIconDetail\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-8 w-8 text-gray-400 heart-icon\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"\/>\n                            <\/svg>\n                            <span class=\"text-lg font-bold text-gray-700 dark:text-white\" id=\"lblAddToFav\">Add to Favorites<\/span>\n                        <\/button>\n                    <\/div>\n                <\/div>\n            <\/div>\n        <\/div>\n\n        <!-- Menu Section -->\n        <div id=\"menuSection\" class=\"hidden fade-in max-w-lg mx-auto mt-6\">\n            <h2 class=\"text-2xl font-bold mb-6 text-center dark:text-white\" id=\"lblMenuTitle\">Menu<\/h2>\n            \n            <div class=\"grid gap-4\">\n                <div onclick=\"showSection('settings')\" class=\"bg-white dark:bg-gray-800 p-5 rounded-xl shadow-sm flex items-center justify-between cursor-pointer hover:shadow-md transition\">\n                    <div class=\"flex items-center gap-4\">\n                        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-7 w-7 text-green-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37a1.724 1.724 0 002.572-1.065z\" \/>\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\" \/>\n                        <\/svg>\n                        <span class=\"text-lg font-semibold dark:text-white\" id=\"lblSettingsOpt\">Settings<\/span>\n                    <\/div>\n                    <span class=\"text-gray-400\">❯<\/span>\n                <\/div>\n\n                <div onclick=\"showSection('favorites')\" class=\"bg-white dark:bg-gray-800 p-5 rounded-xl shadow-sm flex items-center justify-between cursor-pointer hover:shadow-md transition\">\n                    <div class=\"flex items-center gap-4\">\n                        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-7 w-7 text-red-500\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                            <path fill-rule=\"evenodd\" d=\"M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z\" clip-rule=\"evenodd\" \/>\n                        <\/svg>\n                        <span class=\"text-lg font-semibold dark:text-white\" id=\"lblFavOpt\">Favorites<\/span>\n                    <\/div>\n                    <span class=\"text-gray-400\">❯<\/span>\n                <\/div>\n            <\/div>\n        <\/div>\n\n        <!-- Settings Section -->\n        <div id=\"settingsSection\" class=\"hidden fade-in max-w-lg mx-auto\">\n            <button onclick=\"showSection('menu')\" class=\"mb-4 back-button text-gray-600 dark:text-gray-300 hover:text-green-600 font-semibold\">\n                <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-5 w-5 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 19l-7-7 7-7\" \/>\n                <\/svg>\n                <span id=\"lblBackSettings\">Back to Menu<\/span>\n            <\/button>\n\n            <h2 class=\"text-2xl font-bold mb-6 dark:text-white\" id=\"lblSettingsTitle\">Settings<\/h2>\n\n            <div class=\"bg-white dark:bg-gray-800 rounded-xl shadow-sm p-6 mb-4\">\n                <div class=\"flex justify-between items-center mb-6\">\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"text-xl\">🌙<\/span>\n                        <div>\n                            <h4 class=\"font-bold dark:text-white\" id=\"lblTheme\">Theme<\/h4>\n                            <p class=\"text-xs text-gray-500 dark:text-gray-400\" id=\"lblThemeDesc\">Toggle Dark Mode<\/p>\n                        <\/div>\n                    <\/div>\n                    <label class=\"relative inline-flex items-center cursor-pointer\">\n                        <input type=\"checkbox\" id=\"themeToggle\" class=\"sr-only peer\" onchange=\"toggleTheme()\">\n                        <div class=\"w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-600\"><\/div>\n                    <\/label>\n                <\/div>\n                \n                <!-- Language selection removed from view as requested \"All text in English\", kept logic just in case -->\n                <div class=\"hidden\">\n                    <select id=\"langSelect\"><option value=\"en\">English<\/option><\/select>\n                <\/div>\n            <\/div>\n        <\/div>\n\n        <!-- Favorites Section -->\n        <div id=\"favoritesSection\" class=\"hidden fade-in\">\n            <button onclick=\"showSection('menu')\" class=\"mb-4 back-button text-gray-600 dark:text-gray-300 hover:text-green-600 font-semibold\">\n                <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-5 w-5 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 19l-7-7 7-7\" \/>\n                <\/svg>\n                <span id=\"lblBackFav\">Back to Menu<\/span>\n            <\/button>\n            <h2 class=\"text-2xl font-bold mb-4 dark:text-white\" id=\"lblFavTitle\">Favorite List<\/h2>\n            <div id=\"favListContainer\" class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\">\n                <\/div>\n            <div id=\"noFavs\" class=\"hidden text-center mt-10 text-gray-500 dark:text-gray-400\">\n                <p id=\"lblNoFav\">No favorite products yet.<\/p>\n            <\/div>\n        <\/div>\n\n    <\/div>\n\n    <!-- Banner Ads Area (Fixed Above Bottom Nav) -->\n    <div class=\"fixed bottom-16 left-0 w-full ad-container\" id=\"bannerAd\">\n        <script type=\"text\/javascript\">\n            atOptions = {\n                'key' : 'f51e5124081653e767bc037c145ef891',\n                'format' : 'iframe',\n                'height' : 50,\n                'width' : 320,\n                'params' : {}\n            };\n        <\/script>\n        <script type=\"text\/javascript\" src=\"https:\/\/www.highperformanceformat.com\/f51e5124081653e767bc037c145ef891\/invoke.js\"><\/script>\n    <\/div>\n\n    <!-- Bottom Navigation -->\n    <div class=\"fixed bottom-0 left-0 w-full bg-white dark:bg-gray-800 shadow-[0_-2px_10px_rgba(0,0,0,0.1)] border-t border-gray-100 dark:border-gray-700 z-50 flex justify-around items-center h-16 transition-colors\">\n        \n        <div onclick=\"showSection('home')\" class=\"flex flex-col items-center justify-center w-full h-full cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 group\" id=\"navHome\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-6 w-6 mb-1 group-hover:text-green-600 transition\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\" \/>\n            <\/svg>\n            <span class=\"text-xs font-medium group-hover:text-green-600\" id=\"navLblHome\">Home<\/span>\n        <\/div>\n\n        <div onclick=\"showSection('menu')\" class=\"flex flex-col items-center justify-center w-full h-full cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 group\" id=\"navMenu\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" class=\"h-6 w-6 mb-1 group-hover:text-green-600 transition\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\" \/>\n            <\/svg>\n            <span class=\"text-xs font-medium group-hover:text-green-600\" id=\"navLblMenu\">Menu<\/span>\n        <\/div>\n    <\/div>\n\n    <script type=\"module\">\n        import { initializeApp } from \"https:\/\/www.gstatic.com\/firebasejs\/9.1.3\/firebase-app.js\";\n        import { getFirestore, collection, getDocs, query, orderBy } from \"https:\/\/www.gstatic.com\/firebasejs\/9.1.3\/firebase-firestore.js\";\n\n        const firebaseConfig = {\n            apiKey: \"AIzaSyD8HPaMdMTMX_TH4XH2HvtsGzDIjjvMNo0\",\n            authDomain: \"bazardor-a23b4.firebaseapp.com\",\n            projectId: \"bazardor-a23b4\",\n            storageBucket: \"bazardor-a23b4.firebasestorage.app\",\n            messagingSenderId: \"49130907796\",\n            appId: \"1:49130907796:web:4d9af58a09375cb0ea2c81\"\n        };\n\n        const app = initializeApp(firebaseConfig);\n        const db = getFirestore(app);\n\n        let allProducts = [];\n        let currentProduct = null;\n        \n        \/\/ --- LOCAL STATE ---\n        let likedProducts = JSON.parse(localStorage.getItem('bazardor_favs')) || [];\n        let currentLang = 'en'; \/\/ Forced to English\n        let isDark = localStorage.getItem('bazardor_theme') === 'dark';\n\n        \/\/ --- TRANSLATIONS (Only English needed now, but kept structure) ---\n        const i18n = {\n            en: {\n                appTitle: \"Bazardor\",\n                searchPlaceholder: \"Search products (e.g. Potato)...\",\n                loading: \"Loading...\",\n                noResults: \"Sorry! No products found.\",\n                back: \"Go Back\",\n                menuBack: \"Back to Menu\",\n                update: \"Updated\",\n                desc: \"Description:\",\n                addToFav: \"Add to Favorites\",\n                removeFromFav: \"Remove from Favorites\",\n                menuTitle: \"Menu\",\n                settingsOpt: \"Settings\",\n                favOpt: \"Favorites\",\n                settingsTitle: \"Settings\",\n                theme: \"Theme\",\n                themeDesc: \"Toggle Dark Mode\",\n                favTitle: \"Favorites List\",\n                noFav: \"No favorite products yet.\",\n                navHome: \"Home\",\n                navMenu: \"Menu\",\n                notifTitle: \"Notifications\"\n            }\n        };\n\n        \/\/ --- INITIALIZATION ---\n        \n        function applySettings() {\n            \/\/ Theme\n            const body = document.documentElement;\n            const toggle = document.getElementById('themeToggle');\n            if (isDark) {\n                body.classList.add('dark');\n                toggle.checked = true;\n            } else {\n                body.classList.remove('dark');\n                toggle.checked = false;\n            }\n            updateTexts();\n        }\n\n        function updateTexts() {\n            const t = i18n.en;\n            document.getElementById('appTitle').innerText = t.appTitle;\n            document.getElementById('searchBar').placeholder = t.searchPlaceholder;\n            document.getElementById('lblLoading').innerText = t.loading;\n            document.getElementById('lblBack').innerText = t.back;\n            document.getElementById('lblBackSettings').innerText = t.menuBack;\n            document.getElementById('lblBackFav').innerText = t.menuBack;\n            document.getElementById('lblUpdate').innerText = t.update;\n            document.getElementById('lblDesc').innerText = t.desc;\n            document.getElementById('lblMenuTitle').innerText = t.menuTitle;\n            document.getElementById('lblSettingsOpt').innerText = t.settingsOpt;\n            document.getElementById('lblFavOpt').innerText = t.favOpt;\n            document.getElementById('lblSettingsTitle').innerText = t.settingsTitle;\n            document.getElementById('lblTheme').innerText = t.theme;\n            document.getElementById('lblThemeDesc').innerText = t.themeDesc;\n            document.getElementById('lblFavTitle').innerText = t.favTitle;\n            document.getElementById('lblNoFav').innerText = t.noFav;\n            document.getElementById('navLblHome').innerText = t.navHome;\n            document.getElementById('navLblMenu').innerText = t.navMenu;\n            document.getElementById('lblNotifTitle').innerText = t.notifTitle;\n            document.getElementById('noResults').querySelector('p').innerText = t.noResults;\n\n            \/\/ Dynamic Button Text Check\n            if(currentProduct) {\n                const isFav = likedProducts.includes(currentProduct.id);\n                document.getElementById('lblAddToFav').innerText = isFav ? t.removeFromFav : t.addToFav;\n            }\n        }\n\n        window.toggleTheme = () => {\n            isDark = !isDark;\n            localStorage.setItem('bazardor_theme', isDark ? 'dark' : 'light');\n            applySettings();\n        };\n\n        \/\/ --- OFFLINE DETECTION ---\n        function updateOnlineStatus() {\n            const modal = document.getElementById('offlineModal');\n            if (navigator.onLine) {\n                modal.classList.add('hidden');\n            } else {\n                modal.classList.remove('hidden');\n            }\n        }\n        window.addEventListener('online', updateOnlineStatus);\n        window.addEventListener('offline', updateOnlineStatus);\n        \/\/ Initial check\n        updateOnlineStatus();\n\n        \/\/ --- DISABLE ZOOM SCRIPT ---\n        document.addEventListener('gesturestart', function (e) {\n            e.preventDefault();\n        });\n\n        \/\/ --- NAVIGATION LOGIC ---\n\n        const sections = ['homeSection', 'productDetail', 'menuSection', 'settingsSection', 'favoritesSection'];\n\n        window.showSection = (sectionName) => {\n            sections.forEach(id => {\n                const el = document.getElementById(id);\n                if(el) el.classList.add('hidden');\n            });\n\n            const navHome = document.getElementById('navHome');\n            const navMenu = document.getElementById('navMenu');\n            navHome.classList.remove('text-green-600'); \n            navMenu.classList.remove('text-green-600');\n            \n            document.getElementById('searchBar').value = '';\n            document.getElementById('noResults').classList.add('hidden');\n\n            if(sectionName === 'home') {\n                document.getElementById('homeSection').classList.remove('hidden');\n                navHome.classList.add('text-green-600');\n                if (allProducts.length > 0) {\n                     renderProducts(allProducts); \n                     document.getElementById('loader').classList.add('hidden');\n                } else {\n                     document.getElementById('loader').classList.remove('hidden');\n                     document.getElementById('productList').classList.add('hidden');\n                }\n            } \n            else if (sectionName === 'menu' || sectionName === 'settings' || sectionName === 'favorites') {\n                document.getElementById('homeSection').classList.add('hidden');\n                navMenu.classList.add('text-green-600');\n                if (sectionName === 'menu') document.getElementById('menuSection').classList.remove('hidden');\n                if (sectionName === 'settings') document.getElementById('settingsSection').classList.remove('hidden');\n                if (sectionName === 'favorites') {\n                    document.getElementById('favoritesSection').classList.remove('hidden');\n                    renderFavorites();\n                }\n            }\n            else if (sectionName === 'detail') {\n                document.getElementById('productDetail').classList.remove('hidden');\n                navHome.classList.add('text-green-600');\n            }\n            window.scrollTo(0,0);\n        };\n\n        window.goBack = () => {\n            showSection('home');\n        };\n\n        \/\/ --- FAVORITES LOGIC ---\n\n        window.toggleFavoriteCurrent = () => {\n            if(!currentProduct) return;\n            const id = currentProduct.id;\n            const index = likedProducts.indexOf(id);\n            const icon = document.getElementById('favIconDetail');\n            \n            if(index === -1) {\n                likedProducts.push(id);\n                icon.classList.add('heart-active');\n            } else {\n                likedProducts.splice(index, 1);\n                icon.classList.remove('heart-active');\n            }\n            localStorage.setItem('bazardor_favs', JSON.stringify(likedProducts));\n            updateTexts();\n        };\n\n        function renderFavorites() {\n            const container = document.getElementById('favListContainer');\n            const noFav = document.getElementById('noFavs');\n            container.innerHTML = '';\n\n            const favProducts = allProducts.filter(p => likedProducts.includes(p.id));\n\n            if(favProducts.length === 0) {\n                noFav.classList.remove('hidden');\n            } else {\n                noFav.classList.add('hidden');\n                favProducts.forEach(data => {\n                    const card = createProductCard(data);\n                    container.innerHTML += card;\n                });\n            }\n        }\n\n        \/\/ --- HELPERS ---\n\n        const formatDate = (timestamp) => {\n            if (!timestamp) return \"N\/A\";\n            const dateObj = timestamp.seconds ? new Date(timestamp.seconds * 1000) : new Date(timestamp);\n            const day = String(dateObj.getDate()).padStart(2, '0');\n            const month = String(dateObj.getMonth() + 1).padStart(2, '0');\n            const year = dateObj.getFullYear();\n            return `${day}\/${month}\/${year}`;\n        };\n\n        function createProductCard(data) {\n            const pid = data.id; \n            const displayDate = formatDate(data.date); \n            return `\n                <div class=\"bg-white dark:bg-gray-800 rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer overflow-hidden border border-gray-100 dark:border-gray-700 p-2 pb-3\" onclick=\"showProduct('${pid}')\">\n                    <div class=\"card-image-container rounded-lg overflow-hidden h-40 md:h-48 mb-3 bg-gray-100 dark:bg-gray-700\">\n                        <img src=\"${data.image}\" alt=\"${data.name}\" class=\"w-full h-full object-cover transition-transform duration-500\">\n                    <\/div>\n                    <div class=\"px-1\">\n                        <h3 class=\"font-bold text-xl text-gray-800 dark:text-white leading-tight\">${data.name}<\/h3>\n                        <p class=\"text-green-600 font-bold text-2xl mt-1\">৳${data.price}<\/p>\n                        <p class=\"text-xs text-gray-400 mt-2 font-medium\">Updated: ${displayDate}<\/p>\n                    <\/div>\n                <\/div>\n            `;\n        }\n\n        function renderProducts(productsToRender) {\n            const listContainer = document.getElementById('productList');\n            const noResults = document.getElementById('noResults');\n            listContainer.innerHTML = '';\n\n            if(productsToRender.length === 0) {\n                listContainer.classList.add('hidden');\n                noResults.classList.remove('hidden');\n                return;\n            } else {\n                noResults.classList.add('hidden');\n            }\n\n            productsToRender.forEach((data) => {\n                listContainer.innerHTML += createProductCard(data);\n            });\n            listContainer.classList.remove('hidden');\n        }\n\n        async function loadProducts() {\n            if (!navigator.onLine) return; \/\/ Prevent load if offline\n            \n            document.getElementById('loader').classList.remove('hidden'); \n            document.getElementById('productList').classList.add('hidden'); \n            document.getElementById('noResults').classList.add('hidden');\n            \n            try {\n                const querySnapshot = await getDocs(collection(db, \"products\"));\n                if(querySnapshot.empty) {\n                    document.getElementById('noResults').classList.remove('hidden');\n                } else {\n                    allProducts = [];\n                    querySnapshot.forEach((doc) => {\n                        allProducts.push({ id: doc.id, ...doc.data() });\n                    });\n                    renderProducts(allProducts);\n                }\n            } catch (error) {\n                console.error(\"Error fetching data:\", error);\n                document.getElementById('productList').innerHTML = '<p class=\"col-span-full text-center text-red-500\">Failed to load data.<\/p>';\n                document.getElementById('productList').classList.remove('hidden');\n            }\n            document.getElementById('loader').classList.add('hidden');\n        }\n\n        window.searchProducts = () => {\n            const searchTerm = document.getElementById('searchBar').value.toLowerCase();\n            const filteredProducts = allProducts.filter(product => \n                product.name.toLowerCase().includes(searchTerm)\n            );\n            renderProducts(filteredProducts);\n        };\n\n        window.showProduct = (id) => {\n            const product = allProducts.find(p => p.id === id);\n            if(product) {\n                currentProduct = product;\n                \n                document.getElementById('dImage').src = product.image;\n                document.getElementById('dName').innerText = product.name;\n                document.getElementById('dPrice').innerText = product.price;\n                document.getElementById('dDesc').innerText = product.description || \"No description available.\";\n                document.getElementById('dDate').innerText = formatDate(product.date);\n\n                const icon = document.getElementById('favIconDetail');\n                if(likedProducts.includes(product.id)) {\n                    icon.classList.add('heart-active');\n                } else {\n                    icon.classList.remove('heart-active');\n                }\n                \n                updateTexts();\n                showSection('detail');\n            }\n        };\n\n        \/\/ --- NOTIFICATIONS ---\n        window.toggleNotifications = () => {\n            const modal = document.getElementById('notificationModal');\n            modal.classList.toggle('hidden');\n            if (!modal.classList.contains('hidden')) {\n                document.getElementById('notifBadge').classList.add('hidden');\n            }\n        };\n\n        window.closeNotificationsOutside = (event) => {\n            const modal = document.getElementById('notificationModal');\n            if (!modal.classList.contains('hidden') && !event.target.closest('#notificationModal') && !event.target.closest('.relative.cursor-pointer')) {\n                modal.classList.add('hidden');\n            }\n        };\n\n        async function loadNotifications() {\n            if (!navigator.onLine) return;\n\n            const listContainer = document.getElementById('notificationList');\n            try {\n                const q = query(collection(db, \"notifications\"), orderBy(\"date\", \"desc\"));\n                const querySnapshot = await getDocs(q);\n                \n                listContainer.innerHTML = '';\n                if(querySnapshot.empty) {\n                    listContainer.innerHTML = `<div class=\"text-center py-6\"><p class=\"text-gray-400 text-sm\">No new notifications<\/p><\/div>`;\n                    return;\n                }\n                document.getElementById('notifBadge').classList.remove('hidden');\n\n                querySnapshot.forEach((doc) => {\n                    const data = doc.data();\n                    const notifDate = data.date ? formatDate(data.date) : '';\n                    listContainer.innerHTML += `\n                        <div class=\"bg-gray-50 dark:bg-gray-700 hover:bg-green-50 dark:hover:bg-gray-600 p-3 rounded-lg mb-2 border border-gray-100 dark:border-gray-600 transition\">\n                            <h4 class=\"font-bold text-gray-800 dark:text-white text-sm\">${data.title || 'Notification'}<\/h4>\n                            <p class=\"text-gray-600 dark:text-gray-300 text-sm mt-1 leading-snug\">${data.message}<\/p>\n                            <p class=\"text-xs text-gray-400 mt-2 text-right\">${notifDate}<\/p>\n                        <\/div>\n                    `;\n                });\n            } catch (error) {\n                console.error(error);\n                listContainer.innerHTML = '<p class=\"text-center text-gray-400 py-4 text-sm\">Failed to load notifications<\/p>';\n            }\n        }\n\n        \/\/ Boot\n        applySettings();\n        loadProducts();\n        loadNotifications();\n        showSection('home');\n\n    <\/script>\n<\/body>\n<\/html>\n","icon":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/bAEMADQkKCwoIDQsKCw4ODQ8TIBUTEhITJxweFyAuKTEwLiktLDM6Sj4zNkY3LC1AV0FGTE5SU1IyPlphWlBgSlFST\/\/bAEMBDg4OExETJhUVJk81LTVPT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT\/\/AABEIAGAAYAMBIgACEQEDEQH\/xAAbAAEAAwEBAQEAAAAAAAAAAAAAAwQFAgEGB\/\/EADUQAAEDAgMDCgMJAAAAAAAAAAABAgMEEQUSIRMxoQYUFSIyQVFSgsEjcbE0U1VjgZGS0dL\/xAAZAQEAAgMAAAAAAAAAAAAAAAAAAQMCBAX\/xAAiEQADAAIBAwUBAAAAAAAAAAAAAQIDETEEEhQhM0FRoeH\/2gAMAwEAAhEDEQA\/AP0cAGRAAAAAAAAAAAAAAAAAAAAAABVr66OijarkVzndlpmdOzX0ij4lsYLtbSKrzRD02boMNMbm+7j4\/wBnqY1L3xx8TLxsn0YeVj+zbBXoqxlXGqtRWub2m+BYKaly9MvmlS2gACCQAAARyPsSEEpMrbIp6Rj4s9kjmrKmbLu13GYjofJxU1K5aJPtKVGb8tW24lDNhPhXfuw6mJ6nWmaGSd1vaOEdF5OKnL1RqorV0U7mdh+ydzfnW07s+W3Aquf1f1Lkt+pTU\/B9Byeddaj0+5smFyZddan0+5unL6r0ys6HT+2gACguAAABBKTkEm8meSK4M+ofVNZ8CuggTwkVE9irtsS\/GaH+af5NKWCGRtpIEf6lQpT4dTvaiRUyRLftI9V+puRUcNfiKGn8P9ZTrpa11G9JsSpZ2aXZG5FcuqbtDHe6zE+ZvdEodMwOGfqzOkaiapkVE+qGzGbHjX8Knjq2eclFutV6Pc+hKuH0EGHwrHAi9Zbuc7VzvmWjnZ8iyZHS4NrHPbKTAAKjMAAAEb2XJAAV8ijIpYsgshPcyO1FfZqSMZYksA22FKQABBIAAAAAAAAAAAAAAAAAAAAB\/9k=","splash":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/bAEMAEAsMDgwKEA4NDhIREBMYKBoYFhYYMSMlHSg6Mz08OTM4N0BIXE5ARFdFNzhQbVFXX2JnaGc+TXF5cGR4XGVnY\/\/bAEMBERISGBUYLxoaL2NCOEJjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY2NjY\/\/AABEIAZAA8AMBIgACEQEDEQH\/xAAbAAEAAgMBAQAAAAAAAAAAAAAAAQMCBAYFB\/\/EAD4QAAIBAgMEBwMKBwADAQAAAAABAgMRBBIhBTFBURMiYWJxodEUMpEGFkJSVIGSo7HSIzNDcrLB8BU0gsL\/xAAYAQEBAQEBAAAAAAAAAAAAAAAAAQIDBP\/EACIRAQADAAMBAAIDAQEAAAAAAAABAhEDEiExEyJBUWEyYv\/aAAwDAQACEQMRAD8A4cAHVyAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAALiwOwD0Key6tTArE+00IuUJVI0XJ55Ri3drS30ZceBRDBYqpKEadOU3NJxUHmvpe2nG3DfquZlHHzjQhT6Kk5QpypQqO+aMZZrrfb6UuHEzw+1sZh503TnBKGXRQir5d17Wf37+0nq+KqWCxdal0lKlOpHuavity14MirhMXRjmqUKsY2Tu4uzRbDamLpqcaUqcKc73gqcbWbvbVbtdOROK2ri8XCCrSg5RTTmopOV77\/