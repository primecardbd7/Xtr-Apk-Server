{"code":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Xtr Pic App<\/title>\n    <style>\n        \/* --- RESET & BASICS --- *\/\n        * { box-sizing: border-box; margin: 0; padding: 0; outline: none; -webkit-tap-highlight-color: transparent; }\n        body { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; background-color: #f5f5f5; color: #333; padding-bottom: 80px; }\n        \n        \/* --- CONFIG VARIABLES --- *\/\n        :root {\n            --primary: #e60023; \/* Pinterest Red *\/\n            --dark: #111;\n            --light: #fff;\n            --gray: #efefef;\n            --text-sub: #767676;\n            --radius: 16px;\n            --shadow: 0 4px 12px rgba(0,0,0,0.1);\n        }\n\n        \/* --- HEADER --- *\/\n        header {\n            position: fixed; top: 0; left: 0; width: 100%; height: 60px;\n            background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);\n            display: flex; align-items: center; justify-content: center;\n            z-index: 1000; box-shadow: 0 1px 0 rgba(0,0,0,0.05);\n        }\n        .logo { font-size: 20px; font-weight: 700; color: var(--primary); letter-spacing: -0.5px; }\n\n        \/* --- MASONRY GRID --- *\/\n        .container { max-width: 1400px; margin: 70px auto 0; padding: 0 10px; }\n        \n        .masonry {\n            column-count: 2; \/* Mobile Default *\/\n            column-gap: 10px;\n        }\n\n        @media (min-width: 768px) { .masonry { column-count: 3; } }\n        @media (min-width: 1024px) { .masonry { column-count: 4; } }\n\n        \/* --- CARD DESIGN --- *\/\n        .card {\n            break-inside: avoid; margin-bottom: 15px; position: relative;\n            background: var(--light); border-radius: var(--radius); overflow: hidden;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.05); transform: translateZ(0);\n        }\n        \n        \/* Media Image *\/\n        .card img { width: 100%; display: block; height: auto; object-fit: cover; }\n        \n        \/* Badges *\/\n        .badge {\n            position: absolute; top: 10px; left: 10px;\n            background: rgba(0,0,0,0.6); color: white;\n            font-size: 10px; font-weight: 700; padding: 4px 8px;\n            border-radius: 12px; pointer-events: none;\n            display: flex; align-items: center; gap: 4px;\n        }\n\n        \/* Interaction Overlay (Always visible on touch, hover on desktop) *\/\n        .overlay {\n            position: absolute; bottom: 0; left: 0; width: 100%;\n            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);\n            padding: 40px 10px 10px; display: flex; justify-content: space-between; align-items: flex-end;\n        }\n\n        \/* Photographer Name *\/\n        .info { flex: 1; min-width: 0; margin-right: 10px; }\n        .photographer {\n            color: white; font-size: 12px; font-weight: 600;\n            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n        }\n\n        \/* Action Buttons *\/\n        .actions { display: flex; gap: 8px; }\n        .btn-icon {\n            width: 32px; height: 32px; border-radius: 50%;\n            background: rgba(255,255,255,0.9); border: none; cursor: pointer;\n            display: flex; align-items: center; justify-content: center;\n            font-size: 16px; transition: transform 0.2s;\n        }\n        .btn-icon:active { transform: scale(0.9); }\n        .btn-save.saved { background: var(--primary); color: white; }\n\n        \/* --- BOTTOM NAV --- *\/\n        .bottom-nav {\n            position: fixed; bottom: 0; left: 0; width: 100%; height: 60px;\n            background: white; border-top: 1px solid #eee;\n            display: flex; justify-content: space-around; align-items: center;\n            z-index: 1000; padding-bottom: env(safe-area-inset-bottom);\n        }\n        .nav-item {\n            flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;\n            background: none; border: none; color: #999; font-size: 10px; gap: 4px; cursor: pointer;\n        }\n        .nav-item.active { color: var(--dark); font-weight: 700; }\n        .nav-icon { font-size: 20px; }\n\n        \/* --- SEARCH MODAL --- *\/\n        .search-bar-container {\n            display: none; position: fixed; top: 60px; left: 0; width: 100%;\n            background: white; padding: 10px; z-index: 999; box-shadow: 0 4px 10px rgba(0,0,0,0.05);\n        }\n        .search-bar-container.active { display: block; }\n        .search-input {\n            width: 100%; padding: 12px 20px; border-radius: 24px;\n            border: 1px solid #ddd; background: #f5f5f5; font-size: 16px;\n        }\n\n        \/* --- FULLSCREEN MODAL (VIDEO\/IMAGE) --- *\/\n        .modal {\n            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n            background: black; z-index: 2000; flex-direction: column;\n        }\n        .modal.active { display: flex; }\n        \n        .modal-content {\n            flex: 1; display: flex; align-items: center; justify-content: center;\n            width: 100%; overflow: hidden; position: relative;\n        }\n        .modal-media { max-width: 100%; max-height: 100%; }\n        \n        .modal-controls {\n            background: #111; color: white; padding: 20px;\n            display: flex; flex-direction: column; gap: 15px;\n            border-top: 1px solid #333;\n        }\n        .modal-header { display: flex; justify-content: space-between; align-items: center; }\n        .modal-actions { display: flex; gap: 15px; justify-content: center; margin-top: 10px; }\n        \n        .big-btn {\n            background: #333; color: white; border: none; padding: 10px 20px;\n            border-radius: 24px; font-weight: 600; display: flex; align-items: center; gap: 8px; cursor: pointer;\n        }\n        .big-btn.primary { background: var(--primary); }\n        .close-modal {\n            position: absolute; top: 20px; right: 20px; background: rgba(0,0,0,0.5); color: white;\n            border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 24px; z-index: 2001; cursor: pointer;\n        }\n\n        \/* Loading \/ Empty States *\/\n        .status-msg { text-align: center; padding: 40px; color: var(--text-sub); width: 100%; grid-column: span 2; }\n        .hidden { display: none !important; }\n    <\/style>\n<\/head>\n<body>\n\n    <!-- HEADER -->\n    <header>\n        <div class=\"logo\">xtr pic app<\/div>\n    <\/header>\n\n    <!-- SEARCH BAR -->\n    <div id=\"searchContainer\" class=\"search-bar-container\">\n        <input type=\"text\" id=\"searchInput\" class=\"search-input\" placeholder=\"Search photos & videos...\">\n    <\/div>\n\n    <!-- MAIN GRID -->\n    <div class=\"container\">\n        <div id=\"masonryGrid\" class=\"masonry\">\n            <!-- Cards go here -->\n        <\/div>\n        <div id=\"statusMsg\" class=\"status-msg\">Loading...<\/div>\n    <\/div>\n\n    <!-- MODAL VIEWER -->\n    <div id=\"mediaModal\" class=\"modal\">\n        <button class=\"close-modal\" onclick=\"closeModal()\">×<\/button>\n        <div class=\"modal-content\" id=\"modalContent\">\n            <!-- Image or Video injected here -->\n        <\/div>\n        <div class=\"modal-controls\">\n            <div class=\"modal-header\">\n                <span id=\"modalPhotographer\" style=\"font-weight: bold;\">Photographer<\/span>\n                <span id=\"modalType\" style=\"color:#888; font-size: 12px;\">PHOTO<\/span>\n            <\/div>\n            <div class=\"modal-actions\">\n                <button class=\"big-btn\" id=\"modalSaveBtn\">ðŸ”– Save<\/button>\n                <button class=\"big-btn primary\" id=\"modalDownloadBtn\">â¬‡ Download<\/button>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- BOTTOM NAV -->\n    <div class=\"bottom-nav\">\n        <button class=\"nav-item active\" onclick=\"switchTab('home')\">\n            <span class=\"nav-icon\">ðŸ  <\/span><span>Home<\/span>\n        <\/button>\n        <button class=\"nav-item\" onclick=\"toggleSearch()\">\n            <span class=\"nav-icon\">ðŸ” <\/span><span>Search<\/span>\n        <\/button>\n        <button class=\"nav-item\" onclick=\"switchTab('saved')\">\n            <span class=\"nav-icon\">ðŸ”–<\/span><span>Saved<\/span>\n        <\/button>\n    <\/div>\n\n<script>\n    \/\/ --- CONFIG ---\n    const API_KEY = \"17CEKiBG13gjDqloGEvNkaq25WmTJqBMTfErCspWrJrHU3ePLiazbA6C\";\n    const BASE_URL_PHOTO = \"https:\/\/api.pexels.com\/v1\";\n    const BASE_URL_VIDEO = \"https:\/\/api.pexels.com\/videos\";\n    \n    \/\/ --- STATE ---\n    let state = {\n        mode: 'home', \/\/ home, search, saved\n        items: [],\n        saved: [],\n        page: 1,\n        query: 'nature', \/\/ Default mix\n        isLoading: false,\n        hasMore: true\n    };\n\n    \/\/ --- INIT ---\n    document.addEventListener(\"DOMContentLoaded\", () => {\n        loadSaved();\n        fetchMixedContent();\n        setupSearch();\n        setupScroll();\n    });\n\n    \/\/ --- DATA FETCHING (MIXED PHOTOS + VIDEOS) ---\n    async function fetchMixedContent(isNewSearch = false) {\n        if (state.isLoading || !state.hasMore) return;\n        state.isLoading = true;\n        document.getElementById('statusMsg').innerText = \"Loading...\";\n\n        if (isNewSearch) {\n            state.page = 1;\n            state.items = [];\n            document.getElementById('masonryGrid').innerHTML = \"\";\n            window.scrollTo(0,0);\n        }\n\n        try {\n            \/\/ Fetch Photos\n            const photoRes = await fetch(`${BASE_URL_PHOTO}\/${state.mode === 'search' ? 'search' : 'curated'}?query=${state.query}&per_page=10&page=${state.page}`, {\n                headers: { Authorization: API_KEY }\n            });\n            const photoData = await photoRes.json();\n\n            \/\/ Fetch Videos\n            const videoRes = await fetch(`${BASE_URL_VIDEO}\/${state.mode === 'search' ? 'search' : 'popular'}?query=${state.query}&per_page=10&page=${state.page}`, {\n                headers: { Authorization: API_KEY }\n            });\n            const videoData = await videoRes.json();\n\n            \/\/ Normalize Data\n            const photos = (photoData.photos || []).map(p => ({\n                id: p.id,\n                type: 'photo',\n                src: p.src.large2x, \/\/ High quality for display\n                downloadSrc: p.src.original,\n                photographer: p.photographer,\n                preview: p.src.medium\n            }));\n\n            const videos = (videoData.videos || []).map(v => ({\n                id: v.id,\n                type: 'video',\n                src: v.video_files.sort((a,b) => b.width - a.width)[0]?.link, \/\/ Best quality\n                downloadSrc: v.video_files.sort((a,b) => b.width - a.width)[0]?.link,\n                photographer: v.user.name,\n                preview: v.image\n            }));\n\n            \/\/ Interleave & Shuffle\n            let mixed = [...photos, ...videos].sort(() => Math.random() - 0.5);\n\n            if (mixed.length === 0) {\n                state.hasMore = false;\n                document.getElementById('statusMsg').innerText = \"No more results.\";\n            } else {\n                state.items = [...state.items, ...mixed];\n                renderGrid(mixed);\n                state.page++;\n                document.getElementById('statusMsg').innerText = \"\";\n            }\n\n        } catch (error) {\n            console.error(error);\n            document.getElementById('statusMsg').innerText = \"Error loading content.\";\n        } finally {\n            state.isLoading = false;\n        }\n    }\n\n    \/\/ --- RENDERING ---\n    function renderGrid(items) {\n        const grid = document.getElementById('masonryGrid');\n        \n        items.forEach(item => {\n            const card = document.createElement('div');\n            card.className = 'card';\n            \n            const isSaved = isItemSaved(item.id);\n            const badgeIcon = item.type === 'photo' ? 'ðŸ“¸' : 'ðŸŽ¥';\n            \n            card.innerHTML = `\n                <div class=\"badge\">${badgeIcon} ${item.type.toUpperCase()}<\/div>\n                <img src=\"${item.preview}\" alt=\"Media\" loading=\"lazy\" onclick=\"openModal(${item.id})\">\n                <div class=\"overlay\">\n                    <div class=\"info\">\n                        <div class=\"photographer\">${item.photographer}<\/div>\n                    <\/div>\n                    <div class=\"actions\">\n                        <button class=\"btn-icon btn-save ${isSaved ? 'saved' : ''}\" onclick=\"toggleSave(${item.id}, this)\">\n                            ðŸ”–\n                        <\/button>\n                        <button class=\"btn-icon\" onclick=\"startDownload('${item.downloadSrc}', '${item.type}-${item.id}')\">\n                            â¬‡\n                        <\/button>\n                    <\/div>\n                <\/div>\n            `;\n            grid.appendChild(card);\n        });\n    }\n\n    \/\/ --- SEARCH SYSTEM ---\n    function setupSearch() {\n        const input = document.getElementById('searchInput');\n        let debounce;\n        input.addEventListener('input', (e) => {\n            clearTimeout(debounce);\n            debounce = setTimeout(() => {\n                const query = e.target.value.trim();\n                if (query.length > 2) {\n                    state.query = query;\n                    state.mode = 'search';\n                    state.hasMore = true;\n                    highlightNav('search'); \/\/ Keep visual cue\n                    fetchMixedContent(true);\n                    document.getElementById('searchContainer').classList.remove('active');\n                }\n            }, 600);\n        });\n    }\n\n    function toggleSearch() {\n        const bar = document.getElementById('searchContainer');\n        bar.classList.toggle('active');\n        if (bar.classList.contains('active')) {\n            document.getElementById('searchInput').focus();\n        }\n    }\n\n    \/\/ --- TAB SYSTEM ---\n    function switchTab(tab) {\n        state.mode = tab;\n        highlightNav(tab);\n        const grid = document.getElementById('masonryGrid');\n        const status = document.getElementById('statusMsg');\n\n        if (tab === 'saved') {\n            grid.innerHTML = \"\";\n            status.innerText = \"\";\n            if (state.saved.length === 0) {\n                status.innerText = \"No saved items yet.\";\n            } else {\n                renderGrid(state.saved);\n            }\n            state.hasMore = false; \/\/ No infinite scroll on saved\n        } else if (tab === 'home') {\n            state.query = 'lifestyle'; \/\/ Reset to default interesting topic\n            state.hasMore = true;\n            fetchMixedContent(true);\n        }\n    }\n\n    function highlightNav(tab) {\n        document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));\n        \/\/ Find button containing the text or based on index logic, simplified here:\n        if(tab === 'home') document.querySelectorAll('.nav-item')[0].classList.add('active');\n        if(tab === 'saved') document.querySelectorAll('.nav-item')[2].classList.add('active');\n    }\n\n    \/\/ --- SAVE SYSTEM (LOCALSTORAGE) ---\n    function loadSaved() {\n        const stored = localStorage.getItem('xtr_saved');\n        if (stored) state.saved = JSON.parse(stored);\n    }\n\n    function isItemSaved(id) {\n        return state.saved.some(item => item.id == id);\n    }\n\n    function toggleSave(id, btnElement) {\n        \/\/ Find item in current feed OR in saved list\n        let item = state.items.find(i => i.id == id) || state.saved.find(i => i.id == id);\n        \n        if (!item) return;\n\n        const index = state.saved.findIndex(i => i.id == id);\n        \n        if (index > -1) {\n            \/\/ Remove\n            state.saved.splice(index, 1);\n            if (btnElement) btnElement.classList.remove('saved');\n            \n            \/\/ If currently on saved tab, refresh grid\n            if (state.mode === 'saved') switchTab('saved');\n        } else {\n            \/\/ Add\n            state.saved.push(item);\n            if (btnElement) btnElement.classList.add('saved');\n        }\n\n        localStorage.setItem('xtr_saved', JSON.stringify(state.saved));\n        \n        \/\/ Sync Modal button if open\n        const modalSaveBtn = document.getElementById('modalSaveBtn');\n        if(document.getElementById('mediaModal').style.display === 'flex') {\n             updateModalSaveBtn(id);\n        }\n    }\n\n    \/\/ --- MODAL SYSTEM ---\n    let currentModalItem = null;\n\n    function openModal(id) {\n        const item = state.items.find(i => i.id == id) || state.saved.find(i => i.id == id);\n        if (!item) return;\n        currentModalItem = item;\n\n        const modal = document.getElementById('mediaModal');\n        const content = document.getElementById('modalContent');\n        \n        \/\/ Populate Info\n        document.getElementById('modalPhotographer').innerText = item.photographer;\n        document.getElementById('modalType').innerText = item.type.toUpperCase();\n\n        \/\/ Setup Buttons\n        const dlBtn = document.getElementById('modalDownloadBtn');\n        dlBtn.onclick = () => startDownload(item.downloadSrc, `${item.type}-${item.id}`);\n        \n        const saveBtn = document.getElementById('modalSaveBtn');\n        saveBtn.onclick = () => toggleSave(item.id, null); \/\/ Pass null as we update text manually\n        updateModalSaveBtn(item.id);\n\n        \/\/ Render Media\n        content.innerHTML = '';\n        if (item.type === 'video') {\n            const video = document.createElement('video');\n            video.src = item.src;\n            video.controls = true;\n            video.autoplay = true;\n            video.className = 'modal-media';\n            video.style.maxHeight = '60vh'; \/\/ Ensure room for controls\n            content.appendChild(video);\n        } else {\n            const img = document.createElement('img');\n            img.src = item.src;\n            img.className = 'modal-media';\n            content.appendChild(img);\n        }\n\n        modal.classList.add('active');\n    }\n\n    function updateModalSaveBtn(id) {\n        const saveBtn = document.getElementById('modalSaveBtn');\n        if (isItemSaved(id)) {\n            saveBtn.innerHTML = \"ðŸ”– Saved\";\n            saveBtn.style.background = \"var(--primary)\";\n        } else {\n            saveBtn.innerHTML = \"ðŸ”– Save\";\n            saveBtn.style.background = \"#333\";\n        }\n    }\n\n    function closeModal() {\n        document.getElementById('mediaModal').classList.remove('active');\n        document.getElementById('modalContent').innerHTML = \"\"; \/\/ Stop video playback\n    }\n\n    \/\/ --- DOWNLOAD SYSTEM (FETCH + BLOB) ---\n    async function startDownload(url, filename) {\n        \/\/ Visual Feedback\n        const originalText = event ? event.target.innerText : '';\n        if(event && event.target.tagName === 'BUTTON') event.target.innerText = \"â ³\";\n\n        try {\n            const res = await fetch(url);\n            const blob = await res.blob();\n            const blobURL = URL.createObjectURL(blob);\n            \n            const a = document.createElement(\"a\");\n            a.href = blobURL;\n            \/\/ Detect extension from type or default\n            let ext = \"jpg\";\n            if (blob.type.includes(\"video\")) ext = \"mp4\";\n            \n            a.download = `${filename}.${ext}`;\n            document.body.appendChild(a);\n            a.click();\n            a.remove();\n            URL.revokeObjectURL(blobURL);\n\n        } catch (e) {\n            alert(\"Download failed due to CORS or Network error.\");\n        } finally {\n            if(event && event.target.tagName === 'BUTTON') event.target.innerText = originalText;\n        }\n    }\n\n    \/\/ --- INFINITE SCROLL ---\n    function setupScroll() {\n        window.addEventListener('scroll', () => {\n            if (state.mode === 'saved') return; \/\/ No scroll fetch on saved page\n            \n            const { scrollTop, scrollHeight, clientHeight } = document.documentElement;\n            if (scrollTop + clientHeight >= scrollHeight - 200) {\n                fetchMixedContent();\n            }\n        });\n    }\n\n<\/script>\n<\/body>\n<\/html>\n","icon":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/bAEMADQkKCwoIDQsKCw4ODQ8TIBUTEhITJxweFyAuKTEwLiktLDM6Sj4zNkY3LC1AV0FGTE5SU1IyPlphWlBgSlFST\/\/bAEMBDg4OExETJhUVJk81LTVPT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT\/\/AABEIAGAAYAMBIgACEQEDEQH\/xAAbAAACAwEBAQAAAAAAAAAAAAAAAwEEBQIGB\/\/EADwQAAEDAgQCBQkGBgMAAAAAAAEAAgMEEQUSITFRkRMUQVNhFiJxcoGUsdHSBiMyM0KSQ1JUYqGig8Hh\/8QAGQEAAwEBAQAAAAAAAAAAAAAAAAECAwQF\/8QAHhEBAQEBAAIDAQEAAAAAAAAAAAERAgMSEzFBFDL\/2gAMAwEAAhEDEQA\/APnthsAEWHAckLZ+y2G0+J4qYqoExRxmQtBtm1AtcelbybcY2yTaxrDgOSLDgOS+gVX2cweNpLKS3\/K\/5rHkwWhkl6GOMxlwNnBxNjbgSt\/5u81lPPzbjy9hwHJFhwHJMqIJKad8Mos9hsUtc7YWHAckWHAckIQBYcByRYcByQhASxhe4Na0EqZY3MOVwsQOabRyNinDn7HRdYhO2eYuY1rRcmzdhfsHggKy9B9i39Hi8xP9OR\/s1YAFzrtuvQ4bRyUUhlY9geW5TYE6e0+C08X+pajyTebHpqyoBadVjmobHVNkdfKCb29C6eZpBq9v7VRrGPiLM5BDwbECy9L5OLMjk58dl2uMdNLWQ9LE49NGP5fxDh\/2vPLWlt0MnqH4KnTUMtVTTTRuZaEtGUkguJBOmltmncjmvN8sk6dvP0qoV5+EV0cQkkgLAXlhD\/NsRa976aXN+GU3tZOpcAxCqkmiji++haC6KxLtb6EAHKdD+K1lnqmWhaEeD1kjmNYIz0kkcTD0gs5z9gPntpvteu6jnZTunc1ojaQL5263vtrqNDqOB4I0K6DshB2QSR2+g\/BepkY58YDS4HMDo62l9f8AF15YGyvwV9ZI7KJtQL\/gCrmlWz