{"code":"<!DOCTYPE html>\n<html lang=\"bn\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>ওয়ালপেপার অ্যাপ<\/title>\n    <script src=\"https:\/\/www.gstatic.com\/firebasejs\/8.10.0\/firebase-app.js\"><\/script>\n    <script src=\"https:\/\/www.gstatic.com\/firebasejs\/8.10.0\/firebase-database.js\"><\/script>\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.0\/css\/all.min.css\">\n    <link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https:\/\/fonts.gstatic.com\" crossorigin>\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Roboto&family=Tiro+Bangla&family=Lobster&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --primary-color: #4CAF50;\n            --background-color: #121212;\n            --text-color: white;\n            --card-bg-color: #1E1E1E;\n            --shadow-color-light: rgba(0, 0, 0, 0.7);\n            --shadow-color-hover: rgba(76, 175, 80, 0.5);\n            --nav-bg-color: #111;\n            --nav-text-color: #f1f1f1;\n            --danger-color: #E53935;\n        }\n\n        body {\n            font-family: 'Arial', sans-serif;\n            margin: 0;\n            background-color: var(--background-color);\n            color: var(--text-color);\n            transition: background-color 0.3s, color 0.3s;\n        }\n\n        body.light-theme {\n            --background-color: #F0F2F5;\n            --text-color: #333;\n            --card-bg-color: #FFFFFF;\n            --shadow-color-light: rgba(0, 0, 0, 0.1);\n            --shadow-color-hover: rgba(76, 175, 80, 0.3);\n            --nav-bg-color: #f1f1f1;\n            --nav-text-color: #333;\n        }\n\n        .header {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 15px 20px;\n            background-color: var(--card-bg-color);\n            box-shadow: 0 2px 10px var(--shadow-color-light);\n            position: sticky;\n            top: 0;\n            z-index: 999;\n        }\n\n        .menu-icon {\n            font-size: 1.8em;\n            cursor: pointer;\n            color: var(--primary-color);\n        }\n\n        h1 {\n            color: var(--primary-color);\n            font-size: 1.8em;\n            margin: 0;\n        }\n        \n        #promo-banner {\n            width: 100%;\n            aspect-ratio: 16 \/ 5;\n            background-color: #000;\n            position: relative;\n            overflow: hidden;\n            display: none;\n        }\n\n        .banner-slide {\n            position: absolute; width: 100%; height: 100%;\n            display: flex; justify-content: center; align-items: center;\n        }\n        .banner-slide.fade-anim {\n            opacity: 0; transition: opacity 1s ease-in-out; z-index: 1;\n        }\n        .banner-slide.fade-anim.active {\n            opacity: 1; z-index: 2;\n        }\n        .banner-slide.slide_right-anim {\n            transform: translateX(100%); transition: transform 1s ease-in-out; z-index: 1;\n        }\n        .banner-slide.slide_right-anim.active {\n            transform: translateX(0); z-index: 2;\n        }\n        .banner-slide.slide_right-anim.prev {\n            transform: translateX(-100%); z-index: 1;\n        }\n        .banner-slide img {\n            width: 100%; height: 100%; object-fit: cover;\n        }\n        .banner-slide .banner-text {\n            color: white; font-size: 2.5em; padding: 20px;\n            text-align: center; text-shadow: 2px 2px 8px rgba(0,0,0,0.7);\n        }\n\n        #wallpaper-gallery {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 15px; padding: 20px;\n        }\n\n        .wallpaper-item {\n            overflow: hidden; border-radius: 12px;\n            box-shadow: 0 6px 15px var(--shadow-color-light);\n            transition: transform 0.3s; cursor: pointer;\n        }\n        .wallpaper-item:hover {\n            transform: scale(1.05);\n        }\n        .wallpaper-item img {\n            width: 100%; height: 250px; object-fit: cover; display: block;\n        }\n        \n        #wallpaper-detail-view {\n            position: fixed; top: 0; left: 0;\n            width: 100%; height: 100%;\n            background-color: #000;\n            display: none; justify-content: center; align-items: center;\n            z-index: 1000;\n        }\n        #wallpaper-detail-view.show { display: flex; }\n        #wallpaper-detail-view img {\n            max-width: 100%; max-height: 100%;\n            object-fit: contain;\n        }\n\n        .action-btn {\n            background: none; border: none; color: white;\n            font-size: 2em; cursor: pointer; transition: opacity 0.3s;\n            text-shadow: 1px 1px 5px rgba(0,0,0,0.5);\n        }\n        \n        #home-btn {\n            position: absolute; top: 20px; left: 20px;\n        }\n        \n        .detail-view-bottom-actions {\n            position: absolute;\n            bottom: 30px;\n            left: 50%;\n            transform: translateX(-50%);\n            display: flex;\n            gap: 40px;\n            align-items: center;\n            transition: opacity 0.3s;\n        }\n\n        \/* নতুন CSS কোড: ফুলস্ক্রিন মোডের জন্য *\/\n        #wallpaper-detail-view.fullscreen-mode #home-btn,\n        #wallpaper-detail-view.fullscreen-mode .detail-view-bottom-actions {\n            opacity: 0;\n            pointer-events: none; \/* বাটনগুলোকে অদৃশ্য অবস্থায় ক্লিক করা থেকে বিরত রাখতে *\/\n        }\n\n        #fav-btn { font-size: 2em; }\n        #download-btn { font-size: 2.2em; }\n        #fav-btn.favorited { color: #ff4d4d; }\n        \n        #side-nav {\n            height: 100%; width: 0; position: fixed;\n            z-index: 1001; top: 0; left: 0;\n            background-color: var(--nav-bg-color);\n            overflow-x: hidden; transition: 0.5s;\n        }\n        #side-nav .sidebar-header-image {\n            width: 100%;\n            display: block;\n            margin-bottom: 15px;\n        }\n        #side-nav a {\n            padding: 15px 20px; text-decoration: none; font-size: 22px;\n            color: var(--nav-text-color); display: flex; align-items: center;\n            gap: 15px; transition: 0.3s;\n        }\n        #side-nav a:hover { background-color: rgba(76, 175, 80, 0.5); }\n        #side-nav .close-btn {\n            position: absolute; top: 10px; right: 25px; font-size: 36px;\n            padding: 0;\n        }\n        #side-nav .close-btn:hover {\n            background-color: transparent;\n        }\n        \n        #settings-view { display: none; padding: 20px; }\n        #settings-view h2 { color: var(--primary-color); text-align: center; }\n        .setting-item {\n            display: flex; justify-content: space-between; align-items: center;\n            padding: 15px; margin: 10px auto; max-width: 450px;\n            background-color: var(--card-bg-color); border-radius: 10px;\n        }\n        .setting-item span { font-size: 1.2em; color: var(--text-color); }\n\n        .switch { position: relative; display: inline-block; width: 60px; height: 34px; }\n        .switch input { opacity: 0; width: 0; height: 0; }\n        .slider {\n            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;\n            background-color: #ccc; transition: .4s; border-radius: 34px;\n        }\n        .slider:before {\n            position: absolute; content: \"\"; height: 26px; width: 26px;\n            left: 4px; bottom: 4px; background-color: white;\n            transition: .4s; border-radius: 50%;\n        }\n        input:checked + .slider { background-color: var(--primary-color); }\n        input:checked + .slider:before { transform: translateX(26px); }\n\n        .lang-selector {\n            display: flex;\n            gap: 10px;\n        }\n        .lang-btn {\n            background-color: transparent;\n            color: var(--text-color);\n            border: 2px solid var(--danger-color);\n            padding: 8px 18px;\n            border-radius: 20px;\n            cursor: pointer;\n            font-size: 1em;\n            font-weight: bold;\n            transition: background-color 0.3s, color 0.3s;\n        }\n        .lang-btn.active {\n            background-color: var(--danger-color);\n            color: white;\n        }\n        body.light-theme .lang-btn {\n            color: var(--danger-color);\n        }\n        body.light-theme .lang-btn.active {\n            color: white;\n        }\n    <\/style>\n<\/head>\n<body class=\"dark-theme\">\n\n    <div class=\"header\">\n        <i class=\"fas fa-bars menu-icon\" onclick=\"openNav()\"><\/i>\n        <h1 data-lang-key=\"galleryTitle\">ওয়ালপেপার গ্যালারি<\/h1>\n        <div><\/div>\n    <\/div>\n\n    <div id=\"side-nav\">\n        <a href=\"javascript:void(0)\" class=\"close-btn\" onclick=\"closeNav()\">&times;<\/a>\n        <img src=\"https:\/\/i.postimg.cc\/FKfCn8dV\/20251020-121846.jpg\" alt=\"Sidebar Header\" class=\"sidebar-header-image\">\n        <a href=\"#\" onclick=\"showHome()\"><i class=\"fas fa-home\"><\/i><span data-lang-key=\"home\">হোম<\/span><\/a>\n        <a href=\"#\" onclick=\"showFavorites()\"><i class=\"fas fa-heart\"><\/i><span data-lang-key=\"myFavorites\">আমার ফেভারিট<\/span><\/a>\n        <a href=\"#\" onclick=\"showAppSettings()\"><i class=\"fas fa-cog\"><\/i><span data-lang-key=\"appSettings\">অ্যাপ সেটিং<\/span><\/a>\n    <\/div>\n    \n    <div id=\"main-content\">\n        <div id=\"promo-banner\"><\/div>\n        <div id=\"wallpaper-gallery\">\n            <p data-lang-key=\"loading\">ওয়ালপেপার লোড হচ্ছে...<\/p>\n        <\/div>\n    <\/div>\n    \n    <div id=\"settings-view\">\n        <h2 data-lang-key=\"appSettings\">অ্যাপ সেটিং<\/h2>\n        <div class=\"setting-item\">\n            <span data-lang-key=\"theme\">থিম<\/span>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"theme-toggle\" onchange=\"toggleTheme()\">\n                <span class=\"slider\"><\/span>\n            <\/label>\n        <\/div>\n        <div class=\"setting-item\">\n            <span data-lang-key=\"language\">ভাষা<\/span>\n            <div class=\"lang-selector\">\n                <button id=\"lang-btn-bn\" class=\"lang-btn\" onclick=\"setLanguage('bn')\">বাংলা<\/button>\n                <button id=\"lang-btn-en\" class=\"lang-btn\" onclick=\"setLanguage('en')\">ইংরোজি<\/button>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <div id=\"wallpaper-detail-view\">\n        <i id=\"home-btn\" class=\"fas fa-home action-btn\"><\/i>\n        <img id=\"detail-img\" src=\"\" alt=\"Wallpaper\">\n        <div class=\"detail-view-bottom-actions\">\n            <i id=\"download-btn\" class=\"fas fa-download action-btn\"><\/i>\n            <i id=\"fav-btn\" class=\"fas fa-heart action-btn\"><\/i>\n        <\/div>\n    <\/div>\n\n\n<script>\n    const firebaseConfig = {\n        apiKey: \"AIzaSyB_SBNb3yseqJ20fUIdjBrCRkG1k4G6TYA\",\n        authDomain: \"ghgh-fy.firebaseapp.com\",\n        databaseURL: \"https:\/\/ghgh-fy-default-rtdb.firebaseio.com\",\n        projectId: \"ghgh-fy\",\n        appId: \"1:90449364315:web:9305e42454a6c5f98b867e\"\n    };\n\n    firebase.initializeApp(firebaseConfig);\n    const database = firebase.database();\n    const wallpapersRef = database.ref('wallpapers');\n    const bannerSlidesRef = database.ref('banner_slides');\n    const bannerSettingsRef = database.ref('banner_settings');\n\n    const gallery = document.getElementById('wallpaper-gallery');\n    const mainContent = document.getElementById('main-content');\n    const settingsView = document.getElementById('settings-view');\n    const detailView = document.getElementById('wallpaper-detail-view');\n    const detailImg = document.getElementById('detail-img');\n    \n    let allWallpapers = {};\n    let sortedWallpaperList = [];\n    let currentWallpaperIndex = 0;\n    let favorites = JSON.parse(localStorage.getItem('favorites')) || [];\n    let currentLang = localStorage.getItem('language') || 'bn';\n    let bannerInterval;\n\n    const langStrings = {\n        bn: {\n            galleryTitle: 'ওয়ালপেপার গ্যালারি', home: 'হোম', myFavorites: 'আমার ফেভারিট',\n            appSettings: 'অ্যাপ সেটিং', loading: 'ওয়ালপেপার লোড হচ্ছে...',\n            noWallpapers: 'এখনও কোনো ওয়ালপেপার আপলোড করা হয়নি।',\n            downloadSuccess: 'ছবিটি সফলভাবে ডাউনলোড হয়েছে। (আপনার ফোনের ডাউনলোডস ফোল্ডারে দেখুন)', \n            downloadError: 'দুঃখিত, ছবিটি ডাউনলোড করা সম্ভব হয়নি।',\n            mediafireRedirect: 'ডাউনলোড শুরু করার জন্য MediaFire পৃষ্ঠা খোলা হচ্ছে...',\n            theme: 'থিম (সাদা\/ডার্ক)', language: 'ভাষা'\n        },\n        en: {\n            galleryTitle: 'Wallpaper Gallery', home: 'Home', myFavorites: 'My Favorites',\n            appSettings: 'App Settings', loading: 'Loading wallpapers...',\n            noWallpapers: 'No wallpapers have been uploaded yet.',\n            downloadSuccess: 'The image has been downloaded successfully. (Check your phone\\'s Downloads folder)', \n            downloadError: 'Sorry, the image could not be downloaded.',\n            mediafireRedirect: 'Opening MediaFire page to start your download...',\n            theme: 'Theme (Light\/Dark)', language: 'Language'\n        }\n    };\n\n    function setLanguage(lang) {\n        currentLang = lang;\n        localStorage.setItem('language', lang);\n        document.querySelectorAll('[data-lang-key]').forEach(el => {\n            const key = el.getAttribute('data-lang-key');\n            if (langStrings[lang][key]) {\n                el.textContent = langStrings[lang][key];\n            }\n        });\n        document.getElementById('lang-btn-bn').classList.toggle('active', lang === 'bn');\n        document.getElementById('lang-btn-en').classList.toggle('active', lang === 'en');\n    }\n\n    function initializeBanner() {\n        bannerSettingsRef.on('value', settingSnapshot => {\n            const settings = settingSnapshot.val() || { interval: 5000, animation: 'fade' };\n            const bannerContainer = document.getElementById('promo-banner');\n\n            bannerSlidesRef.on('value', slideSnapshot => {\n                if (slideSnapshot.exists()) {\n                    bannerContainer.style.display = 'block';\n                    const slidesData = slideSnapshot.val();\n                    const slides = Object.values(slidesData).sort((a,b) => a.order - b.order);\n                    bannerContainer.innerHTML = ''; \n                    slides.forEach(slide => {\n                        const slideDiv = document.createElement('div');\n                        slideDiv.className = 'banner-slide';\n                        if (slide.type === 'image') {\n                            slideDiv.innerHTML = `<img src=\"${slide.content}\" alt=\"Promo Image\">`;\n                        } else if (slide.type === 'text') {\n                            slideDiv.innerHTML = `<p class=\"banner-text\" style=\"font-family: '${slide.font}', sans-serif;\">${slide.content}<\/p>`;\n                        }\n                        bannerContainer.appendChild(slideDiv);\n                    });\n                    startBannerSlideshow(settings.interval, settings.animation || 'fade');\n                } else {\n                    bannerContainer.style.display = 'none';\n                    if(bannerInterval) clearInterval(bannerInterval);\n                }\n            });\n        });\n    }\n\n    function startBannerSlideshow(interval, animationType) {\n        const slides = document.querySelectorAll('.banner-slide');\n        if (slides.length === 0) return;\n        let currentSlide = 0;\n        if(bannerInterval) clearInterval(bannerInterval);\n        const animClass = `${animationType}-anim`;\n        slides.forEach(slide => {\n            slide.className = 'banner-slide';\n            slide.classList.add(animClass);\n        });\n        slides[currentSlide].classList.add('active');\n        bannerInterval = setInterval(() => {\n            const prevSlide = currentSlide;\n            currentSlide = (currentSlide + 1) % slides.length;\n            if (animationType === 'slide_right') {\n                slides[prevSlide].classList.remove('active');\n                slides[prevSlide].classList.add('prev');\n                slides[currentSlide].classList.remove('prev');\n                slides[currentSlide].classList.add('active');\n                setTimeout(() => { slides[prevSlide].classList.remove('prev'); }, 1000);\n            } else {\n                slides[prevSlide].classList.remove('active');\n                slides[currentSlide].classList.add('active');\n            }\n        }, interval);\n    }\n\n    wallpapersRef.on('value', snapshot => {\n        if (snapshot.exists()) {\n            allWallpapers = snapshot.val();\n            displayWallpapers(allWallpapers);\n        } else {\n            gallery.innerHTML = `<p data-lang-key=\"noWallpapers\">${langStrings[currentLang].noWallpapers}<\/p>`;\n        }\n    }, error => console.error(\"Firebase Read Error:\", error));\n\n    function displayWallpapers(wallpapers) {\n        gallery.innerHTML = '';\n        sortedWallpaperList = Object.keys(wallpapers).map(key => ({\n            id: key, ...wallpapers[key]\n        })).sort((a, b) => b.timestamp - a.timestamp);\n\n        sortedWallpaperList.forEach((wallpaper, index) => {\n            const item = document.createElement('div');\n            item.className = 'wallpaper-item';\n            item.innerHTML = `<img src=\"${wallpaper.url}\" alt=\"Wallpaper Image\">`;\n            item.onclick = () => showDetailView(index);\n            gallery.appendChild(item);\n        });\n    }\n    \n    function updateDetailViewContent(index) {\n        const wallpaper = sortedWallpaperList[index];\n        if (!wallpaper) return;\n\n        const favBtn = document.getElementById('fav-btn');\n        const downloadBtn = document.getElementById('download-btn');\n        \n        detailImg.src = wallpaper.url;\n        updateFavIcon(wallpaper.id);\n        \n        favBtn.onclick = () => toggleFavorite(wallpaper.id);\n        \n        if (wallpaper.downloadUrl && wallpaper.downloadUrl.trim() !== '') {\n            downloadBtn.onclick = () => {\n                alert(langStrings[currentLang].mediafireRedirect);\n                window.open(wallpaper.downloadUrl, '_blank');\n            };\n        } else {\n            downloadBtn.onclick = () => downloadImage(wallpaper.url, `${wallpaper.id || 'wallpaper'}.jpg`);\n        }\n    }\n\n    \/\/ নতুন ফাংশন: ফুলস্ক্রিন ভিউ টগল করার জন্য\n    function toggleFullscreenView() {\n        detailView.classList.toggle('fullscreen-mode');\n    }\n\n    function showDetailView(index) {\n        currentWallpaperIndex = index;\n        updateDetailViewContent(index);\n        detailView.classList.add('show');\n        attachSwipeListeners();\n        \/\/ ফুলস্ক্রিন টগলের জন্য ক্লিক ইভেন্ট যোগ করা হলো\n        detailImg.addEventListener('click', toggleFullscreenView);\n    }\n    \n    function closeDetailView() {\n        detailView.classList.remove('show');\n        \/\/ ভিউ বন্ধ করার সময় ফুলস্ক্রিন মোড সরিয়ে দেওয়া হলো\n        detailView.classList.remove('fullscreen-mode');\n        removeSwipeListeners();\n        \/\/ ইভেন্ট লিসেনার সরিয়ে দেওয়া হলো\n        detailImg.removeEventListener('click', toggleFullscreenView);\n    }\n    \n    document.getElementById('home-btn').onclick = closeDetailView;\n\n    async function downloadImage(imageUrl, fileName) {\n        try {\n            const response = await fetch(imageUrl);\n            if (!response.ok) {\n                throw new Error(`Server error: ${response.statusText}`);\n            }\n            const blob = await response.blob();\n            const url = window.URL.createObjectURL(blob);\n            const a = document.createElement('a');\n            a.style.display = 'none';\n            a.href = url;\n            a.download = fileName;\n            document.body.appendChild(a);\n            a.click();\n            window.URL.revokeObjectURL(url);\n            document.body.removeChild(a);\n            alert(langStrings[currentLang].downloadSuccess);\n        } catch (error) {\n            console.error('Download error:', error);\n            alert(langStrings[currentLang].downloadError);\n        }\n    }\n\n\n    function toggleFavorite(wallpaperId) {\n        const index = favorites.indexOf(wallpaperId);\n        if (index > -1) { favorites.splice(index, 1); } \n        else { favorites.push(wallpaperId); }\n        localStorage.setItem('favorites', JSON.stringify(favorites));\n        updateFavIcon(wallpaperId);\n    }\n\n    function updateFavIcon(wallpaperId) {\n        const favBtn = document.getElementById('fav-btn');\n        if (favorites.includes(wallpaperId)) { favBtn.classList.add('favorited'); } \n        else { favBtn.classList.remove('favorited'); }\n    }\n    \n    let touchStartX = 0;\n    let touchEndX = 0;\n\n    function handleSwipe() {\n        if (touchEndX < touchStartX - 50) {\n            currentWallpaperIndex = (currentWallpaperIndex + 1) % sortedWallpaperList.length;\n            updateDetailViewContent(currentWallpaperIndex);\n        }\n        if (touchEndX > touchStartX + 50) {\n            currentWallpaperIndex = (currentWallpaperIndex - 1 + sortedWallpaperList.length) % sortedWallpaperList.length;\n            updateDetailViewContent(currentWallpaperIndex);\n        }\n    }\n\n    const touchStartHandler = e => touchStartX = e.changedTouches[0].screenX;\n    const touchEndHandler = e => {\n        touchEndX = e.changedTouches[0].screenX;\n        handleSwipe();\n    };\n    \n    function attachSwipeListeners() {\n        detailView.addEventListener('touchstart', touchStartHandler);\n        detailView.addEventListener('touchend', touchEndHandler);\n    }\n    function removeSwipeListeners() {\n        detailView.removeEventListener('touchstart', touchStartHandler);\n        detailView.removeEventListener('touchend', touchEndHandler);\n    }\n\n    function openNav() { document.getElementById(\"side-nav\").style.width = \"280px\"; }\n    function closeNav() { document.getElementById(\"side-nav\").style.width = \"0\"; }\n    function showHome() {\n        displayWallpapers(allWallpapers);\n        mainContent.style.display = 'block'; settingsView.style.display = 'none';\n        closeNav();\n    }\n    function showFavorites() {\n        const favoriteWallpapers = {};\n        favorites.forEach(id => {\n            if (allWallpapers[id]) { favoriteWallpapers[id] = allWallpapers[id]; }\n        });\n        displayWallpapers(favoriteWallpapers);\n        mainContent.style.display = 'block'; settingsView.style.display = 'none';\n        closeNav();\n    }\n    function showAppSettings() {\n        mainContent.style.display = 'none'; settingsView.style.display = 'block';\n        closeNav();\n    }\n\n    function toggleTheme() {\n        document.body.classList.toggle('light-theme');\n        const isLight = document.body.classList.contains('light-theme');\n        localStorage.setItem('theme', isLight ? 'light' : 'dark');\n        document.getElementById('theme-toggle').checked = isLight;\n    }\n    \n    document.addEventListener('DOMContentLoaded', () => {\n        const savedTheme = localStorage.getItem('theme');\n        if (savedTheme === 'light') {\n            document.body.classList.add('light-theme');\n            document.getElementById('theme-toggle').checked = true;\n        }\n        setLanguage(currentLang);\n        initializeBanner();\n    });\n<\/script>\n\n<\/body>\n<\/html>\n","icon":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/bAEMA