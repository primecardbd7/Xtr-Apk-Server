{"code":"<!DOCTYPE html>\n<html lang=\"bn\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Voice Effects Store<\/title>\n    <!-- Material Icons -->\n    <link href=\"https:\/\/fonts.googleapis.com\/icon?family=Material+Icons\" rel=\"stylesheet\">\n    <!-- Google Fonts -->\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Poppins:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        body { \n            font-family: 'Poppins', sans-serif; \n            background-color: #ffffff; \n            margin: 0; \n            padding: 0; \n            overflow-x: hidden;\n            -webkit-tap-highlight-color: transparent;\n        }\n        \n        \/* Main Container *\/\n        .main-container { max-width: 600px; margin: 0 auto; padding: 20px; position: relative; }\n\n        \/* --- SEARCH BAR CSS --- *\/\n        .search-wrapper {\n            position: sticky;\n            top: 10px;\n            z-index: 10;\n            margin-bottom: 25px;\n            background: #fff;\n            padding: 5px 0;\n        }\n\n        .search-box {\n            position: relative;\n            display: flex;\n            align-items: center;\n            width: 100%;\n            background: #f4f6f9;\n            border-radius: 30px;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.05);\n            transition: all 0.3s ease;\n            border: 1px solid transparent;\n        }\n\n        .search-box:focus-within {\n            background: #ffffff;\n            box-shadow: 0 6px 20px rgba(108, 92, 231, 0.15);\n            border-color: #6c5ce7;\n        }\n\n        .search-icon-ui {\n            position: absolute;\n            left: 15px;\n            color: #888;\n            font-size: 24px;\n        }\n\n        #searchInput {\n            width: 100%;\n            padding: 14px 15px 14px 50px;\n            border: none;\n            background: transparent;\n            border-radius: 30px;\n            font-size: 15px;\n            color: #333;\n            outline: none;\n        }\n\n        \/* --- LIST CARD DESIGN --- *\/\n        .voice-card {\n            display: flex;\n            align-items: center;\n            padding: 15px 0;\n            border-bottom: 1px solid #f0f0f0;\n            transition: 0.2s;\n        }\n        .voice-card:last-child { border-bottom: none; }\n\n        \/* List Image (Click to quick play) *\/\n        .img-container {\n            position: relative;\n            width: 65px;\n            height: 65px;\n            border-radius: 12px;\n            overflow: hidden;\n            flex-shrink: 0;\n            cursor: pointer;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n        }\n\n        .voice-img { width: 100%; height: 100%; object-fit: cover; }\n\n        .overlay {\n            position: absolute;\n            top: 0; left: 0; right: 0; bottom: 0;\n            background: linear-gradient(135deg, rgba(108, 92, 231, 0.6), rgba(255, 118, 117, 0.6));\n            display: flex; justify-content: center; align-items: center;\n        }\n        .list-play-icon { color: white; font-size: 28px; }\n\n        \/* Middle Info (Click to Open Details) *\/\n        .info {\n            margin-left: 15px;\n            flex-grow: 1;\n            cursor: pointer; \/* Clickable indication *\/\n        }\n\n        .title {\n            font-size: 16px;\n            font-weight: 600;\n            color: #2d3436;\n            margin: 0 0 3px 0;\n            line-height: 1.2;\n        }\n\n        .desc {\n            font-size: 12px;\n            color: #b2bec3;\n            margin: 0;\n            display: -webkit-box;\n            -webkit-line-clamp: 1;\n            -webkit-box-orient: vertical;\n            overflow: hidden;\n        }\n\n        \/* Quick Download Button *\/\n        .download-btn-sm {\n            color: #b2bec3;\n            padding: 10px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            text-decoration: none;\n        }\n        .download-btn-sm:hover { color: #6c5ce7; background: #f1f2f6; }\n\n        \/* Loading *\/\n        .loading, .no-result { text-align: center; color: #888; margin-top: 50px; font-size: 14px; }\n\n        \/* --- DETAILS PAGE OVERLAY (POPUP) --- *\/\n        #detailView {\n            position: fixed;\n            top: 0; left: 0;\n            width: 100%; height: 100%;\n            background: #ffffff;\n            z-index: 1000;\n            transform: translateY(100%); \/* Initially hidden at bottom *\/\n            transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);\n            overflow-y: auto;\n            display: flex;\n            flex-direction: column;\n        }\n\n        #detailView.active {\n            transform: translateY(0); \/* Slide up to show *\/\n        }\n\n        .detail-header {\n            padding: 20px;\n            display: flex;\n            align-items: center;\n        }\n\n        .back-btn {\n            background: none; border: none;\n            font-size: 28px; color: #333;\n            cursor: pointer; padding: 0;\n        }\n\n        .detail-content {\n            padding: 0 25px 30px 25px;\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n        }\n\n        \/* Detail Image *\/\n        .detail-img-box {\n            width: 100%;\n            height: 300px;\n            border-radius: 20px;\n            overflow: hidden;\n            box-shadow: 0 10px 30px rgba(108, 92, 231, 0.2);\n            margin-bottom: 25px;\n            background: #eee;\n        }\n\n        .detail-full-img {\n            width: 100%; height: 100%; object-fit: cover;\n        }\n\n        \/* Info Row: Name Left, Play Right *\/\n        .detail-info-row {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start; \/* Align top *\/\n            margin-bottom: 15px;\n        }\n\n        .detail-text-area {\n            flex: 1;\n            padding-right: 15px;\n        }\n\n        .detail-title {\n            font-size: 24px;\n            font-weight: 700;\n            color: #2d3436;\n            margin: 0;\n            line-height: 1.2;\n        }\n\n        \/* Detail Play Button *\/\n        .detail-play-btn {\n            width: 55px; height: 55px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, #6c5ce7, #a29bfe);\n            color: white;\n            display: flex; justify-content: center; align-items: center;\n            box-shadow: 0 5px 15px rgba(108, 92, 231, 0.4);\n            cursor: pointer;\n            flex-shrink: 0;\n            transition: transform 0.2s;\n        }\n        .detail-play-btn:active { transform: scale(0.95); }\n        .detail-play-btn span { font-size: 30px; }\n\n        .detail-desc {\n            font-size: 14px;\n            color: #636e72;\n            line-height: 1.6;\n            margin-bottom: 40px;\n        }\n\n        \/* Big Download Button *\/\n        .big-download-btn {\n            margin-top: auto; \/* Push to bottom *\/\n            background: linear-gradient(to right, #6c5ce7, #ff7675);\n            color: white;\n            text-decoration: none;\n            padding: 18px;\n            border-radius: 15px;\n            text-align: center;\n            font-size: 18px;\n            font-weight: 600;\n            box-shadow: 0 8px 20px rgba(108, 92, 231, 0.3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 10px;\n            transition: transform 0.2s;\n        }\n        .big-download-btn:active { transform: scale(0.98); }\n\n    <\/style>\n<\/head>\n<body>\n\n    <!-- LIST PAGE (Main) -->\n    <div class=\"main-container\">\n        \n        <!-- Search Bar -->\n        <div class=\"search-wrapper\">\n            <div class=\"search-box\">\n                <span class=\"material-icons search-icon-ui\">search<\/span>\n                <input type=\"text\" id=\"searchInput\" placeholder=\"ভয়েস খুঁজুন...\">\n            <\/div>\n        <\/div>\n\n        <!-- List Container -->\n        <div id=\"voiceList\">\n            <div class=\"loading\">লোড হচ্ছে...<\/div>\n        <\/div>\n    <\/div>\n\n    <!-- DETAILS PAGE (Hidden by default) -->\n    <div id=\"detailView\">\n        <div class=\"detail-header\">\n            <button class=\"material-icons back-btn\" onclick=\"closeDetails()\">arrow_back<\/button>\n        <\/div>\n        \n        <div class=\"detail-content\">\n            <!-- Image -->\n            <div class=\"detail-img-box\">\n                <img src=\"\" id=\"d-img\" class=\"detail-full-img\" alt=\"Voice Image\">\n            <\/div>\n\n            <!-- Title & Play Button Row -->\n            <div class=\"detail-info-row\">\n                <div class=\"detail-text-area\">\n                    <h1 id=\"d-name\" class=\"detail-title\">Voice Name<\/h1>\n                <\/div>\n                <div class=\"detail-play-btn\" id=\"d-play-btn\" onclick=\"toggleDetailPlay()\">\n                    <span class=\"material-icons\" id=\"d-play-icon\">play_arrow<\/span>\n                <\/div>\n            <\/div>\n\n            <!-- Description -->\n            <p id=\"d-desc\" class=\"detail-desc\">Voice description goes here...<\/p>\n\n            <!-- Big Download Button -->\n            <a href=\"#\" id=\"d-download\" class=\"big-download-btn\" download>\n                <span class=\"material-icons\">cloud_download<\/span> ডাওনলোড করুন\n            <\/a>\n        <\/div>\n    <\/div>\n\n    <!-- Hidden Audio Player -->\n    <audio id=\"mainPlayer\"><\/audio>\n\n<script type=\"module\">\n    import { initializeApp } from \"https:\/\/www.gstatic.com\/firebasejs\/9.1.3\/firebase-app.js\";\n    import { getFirestore, collection, query, orderBy, onSnapshot } from \"https:\/\/www.gstatic.com\/firebasejs\/9.1.3\/firebase-firestore.js\";\n\n    \/\/ Firebase Config\n    const firebaseConfig = {\n      apiKey: \"AIzaSyDKLK8-mUy0h-6sRPllmHbfrGiqCDGE5C8\",\n      authDomain: \"voice-effect-d6101.firebaseapp.com\",\n      projectId: \"voice-effect-d6101\",\n      storageBucket: \"voice-effect-d6101.firebasestorage.app\",\n      messagingSenderId: \"753009061560\",\n      appId: \"1:753009061560:web:172844bc895d78731b0e4d\"\n    };\n\n    const app = initializeApp(firebaseConfig);\n    const db = getFirestore(app);\n    const audioPlayer = document.getElementById('mainPlayer');\n    \n    \/\/ Variables needed\n    let allVoiceData = [];\n    let currentDetailAudioUrl = \"\"; \/\/ To track what is open in details page\n\n    \/\/ --- FIREBASE DATA FETCHING ---\n    const q = query(collection(db, \"voiceEffects\"), orderBy(\"timestamp\", \"desc\"));\n    \n    onSnapshot(q, (snapshot) => {\n        allVoiceData = [];\n        snapshot.forEach((doc) => {\n            allVoiceData.push(doc.data());\n        });\n        renderList(allVoiceData);\n        if(allVoiceData.length === 0){\n            document.getElementById('voiceList').innerHTML = '<div class=\"loading\">কোনো ভয়েস পাওয়া যায়নি।<\/div>';\n        }\n    });\n\n    \/\/ --- RENDER LIST ---\n    \/\/ Note: We attach data-index to easily retrieve object later\n    function renderList(dataArray) {\n        const listContainer = document.getElementById('voiceList');\n        listContainer.innerHTML = '';\n\n        if(dataArray.length === 0) {\n            listContainer.innerHTML = '<div class=\"no-result\">কোনো ফলাফল পাওয়া যায়নি<\/div>';\n            return;\n        }\n\n        dataArray.forEach((data, index) => {\n            \/\/ Encode data so we can pass index safely\n            const itemHTML = `\n                <div class=\"voice-card\">\n                    \n                    <!-- Left: Preview Image (Quick Play) -->\n                    <div class=\"img-container\" onclick=\"playListAudio('${data.audio}', this)\">\n                        <img src=\"${data.image}\" class=\"voice-img\" alt=\"cover\">\n                        <div class=\"overlay\">\n                            <span class=\"material-icons list-play-icon\">play_arrow<\/span>\n                        <\/div>\n                    <\/div>\n\n                    <!-- Middle: Info (Click to Open Details) -->\n                    <div class=\"info\" onclick='openDetails(${JSON.stringify(data)})'>\n                        <h3 class=\"title\">${data.name}<\/h3>\n                        <p class=\"desc\">${data.description || 'No description available'}<\/p>\n                    <\/div>\n\n                    <!-- Right: Quick Download Icon -->\n                    <a href=\"${data.audio}\" class=\"download-btn-sm\" download onclick=\"event.stopPropagation()\">\n                        <span class=\"material-icons\">file_download<\/span>\n                    <\/a>\n                <\/div>\n            `;\n            listContainer.innerHTML += itemHTML;\n        });\n    }\n\n    \/\/ --- SEARCH LOGIC ---\n    document.getElementById('searchInput').addEventListener('input', (e) => {\n        const searchText = e.target.value.toLowerCase();\n        const filteredData = allVoiceData.filter(item => {\n            const nameMatch = item.name.toLowerCase().includes(searchText);\n            const descMatch = item.description && item.description.toLowerCase().includes(searchText);\n            return nameMatch || descMatch;\n        });\n        renderList(filteredData);\n    });\n\n    \/\/ --- AUDIO LOGIC (GLOBAL) ---\n    \/\/ This runs when clicking the small image in the list\n    window.playListAudio = (url, container) => {\n        const icon = container.querySelector('.list-play-icon');\n\n        \/\/ Check if same audio is playing\n        if (!audioPlayer.paused && audioPlayer.src === url) {\n            audioPlayer.pause();\n            return; \n        }\n\n        audioPlayer.src = url;\n        audioPlayer.play();\n    };\n\n    \/\/ Update icons globally based on player state\n    audioPlayer.onplay = () => {\n        updateAllIcons(true);\n    };\n    audioPlayer.onpause = () => {\n        updateAllIcons(false);\n    };\n    audioPlayer.onended = () => {\n        updateAllIcons(false);\n    };\n\n    function updateAllIcons(isPlaying) {\n        const currentSrc = audioPlayer.src;\n\n        \/\/ 1. Update List Icons\n        document.querySelectorAll('.img-container').forEach(cont => {\n            const icon = cont.querySelector('.list-play-icon');\n            \/\/ Check if this container's onclick has the current URL\n            if (cont.getAttribute('onclick').includes(currentSrc) && isPlaying) {\n                icon.innerText = \"pause\";\n            } else {\n                icon.innerText = \"play_arrow\";\n            }\n        });\n\n        \/\/ 2. Update Detail Page Icon\n        const dIcon = document.getElementById('d-play-icon');\n        if (currentDetailAudioUrl && currentSrc.includes(currentDetailAudioUrl) && isPlaying) {\n            dIcon.innerText = \"pause\";\n        } else {\n            dIcon.innerText = \"play_arrow\";\n        }\n    }\n\n\n    \/\/ --- DETAIL PAGE LOGIC ---\n    \n    \/\/ Function to Open Details\n    \/\/ We attach this to window so HTML can see it\n    window.openDetails = (data) => {\n        const detailView = document.getElementById('detailView');\n        \n        \/\/ Populate Data\n        document.getElementById('d-img').src = data.image;\n        document.getElementById('d-name').innerText = data.name;\n        document.getElementById('d-desc').innerText = data.description || \"বিস্তারিত বিবরণ দেওয়া হয়নি।\";\n        document.getElementById('d-download').href = data.audio;\n        \n        currentDetailAudioUrl = data.audio; \/\/ Set current context\n\n        \/\/ Sync Play Button state immediately\n        const dIcon = document.getElementById('d-play-icon');\n        if (!audioPlayer.paused && audioPlayer.src === currentDetailAudioUrl) {\n            dIcon.innerText = \"pause\";\n        } else {\n            dIcon.innerText = \"play_arrow\";\n        }\n\n        \/\/ Show Page (Slide Up)\n        detailView.classList.add('active');\n        \n        \/\/ Disable body scroll\n        document.body.style.overflow = 'hidden';\n    };\n\n    \/\/ Function to Close Details\n    window.closeDetails = () => {\n        document.getElementById('detailView').classList.remove('active');\n        document.body.style.overflow = 'auto'; \/\/ Enable scroll\n    };\n\n    \/\/ Function to Play\/Pause inside Detail Page\n    window.toggleDetailPlay = () => {\n        if (!currentDetailAudioUrl) return;\n\n        if (!audioPlayer.paused && audioPlayer.src === currentDetailAudioUrl) {\n            audioPlayer.pause();\n        } else {\n            audioPlayer.src = currentDetailAudioUrl;\n            audioPlayer.play();\n        }\n    };\n\n<\/script>\n\n<\/body>\n<\/html>","icon":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/bAEMADQkKCwoIDQsKCw4ODQ8TIBUTEhITJxweFyAuKTEwLiktLDM6Sj4zNkY3LC1AV0FGTE5SU1IyPlphWlBgSlFST\/\/bAEMBDg4OExETJhUVJk81LTVPT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT\/\/AABEIAGAAYAMBIgACEQEDEQH\/xAAbAAEAAQUBAAAAAAAAAAAAAAAABgECAwQFB\/\/EACwQAAICAgIBAgQFBQAAAAAAAAABAgMEERIhBQYxExQiQVFhobHRI1JiccL\/xAAZAQEAAwEBAAAAAAAAAAAAAAAAAQIDBAX\/xAAfEQEAAgICAwEBAAAAAAAAAAAAAQMCEQQTEiFBMVH\/2gAMAwEAAhEDEQA\/APOwAeuzAAAAAAAAAAAAAAAAAAAAMlePfbBzrpsnFPTcYtrf4EjGDNbi5NNasux7a4N6UpQaW\/wMIAAEAAAAAAAAC+mt3XV1RaTnJRTft2yX+QvxcGjEpUlXVDaSS9\/bvS\/f8yJ4ak82hQi5SdkdJLbb39je8zc71S\/tHf66\/gvhExPnHx1Va6M\/76SjD8j4nLxrKL7FZVJanFwl\/H6kHyK405NtUJ\/EjCbip61ySfvr7He9J43zHzfW+PD\/AKON5GPDyWVD+26a\/Vmc2xnnOP2HmVY+NuUQ1gAS6QAAAAAAAFYycZKUW1JPaafaPRsD1JgZ+DGV+RVRkRiviQm+C3\/jv3RDvHenvIZ1eLk\/Asrwsi+NHzHHai29b1vet9b9t9b2XZvpvyWNTj5EaJWY2RQroW9Ja+F8SS9+tLl7+\/F6ODm8Onl6jOdTH43ovypn