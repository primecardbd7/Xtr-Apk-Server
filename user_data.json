{"code":"<!doctype html>\n<html lang=\"bn\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Stylish Text<\/title>\n    <style>\n        body { display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; background: #fff; }\n        .text { \n            font-family: system-ui, sans-serif; font-size: 2rem; font-weight: 600; \n            color: #222; cursor: pointer; user-select: none; transition: 0.3s;\n        }\n        @keyframes sweep {\n            0%   { text-shadow: -30px 2px 10px rgba(0, 123, 255, 0.4); }\n            50%  { text-shadow: 0px 4px 15px rgba(40, 167, 69, 0.6); }\n            100% { text-shadow: 30px 2px 10px rgba(220, 53, 69, 0.4); }\n        }\n        .anim { animation: sweep 0.5s cubic-bezier(0.4, 0, 0.2, 1); }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"text\" onclick=\"this.classList.toggle('anim')\">Shopping App Template<\/div>\n<\/body>\n<\/html>","icon":"null","splash":"null"}