{"code":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Professional To-Do Notes<\/title>\n    <!-- Google Fonts -->\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Poppins:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n    <!-- FontAwesome Icons -->\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.0\/css\/all.min.css\">\n    \n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            font-family: 'Poppins', sans-serif;\n        }\n\n        body {\n            background: linear-gradient(135deg, #74ebd5 0%, #9face6 100%);\n            min-height: 100vh;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            padding: 20px;\n        }\n\n        .todo-container {\n            background: #ffffff;\n            width: 100%;\n            max-width: 480px;\n            border-radius: 20px;\n            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);\n            padding: 30px;\n            overflow: hidden;\n        }\n\n        .header {\n            text-align: center;\n            margin-bottom: 25px;\n            color: #333;\n        }\n\n        .header h1 {\n            font-size: 26px;\n            font-weight: 600;\n        }\n\n        .input-section {\n            display: flex;\n            gap: 10px;\n            margin-bottom: 25px;\n        }\n\n        .input-section input {\n            flex: 1;\n            padding: 12px 15px;\n            border: 2px solid #e1e1e1;\n            border-radius: 10px;\n            font-size: 15px;\n            outline: none;\n            transition: all 0.3s;\n        }\n\n        .input-section input:focus {\n            border-color: #9face6;\n        }\n\n        .input-section button {\n            background: #9face6;\n            color: white;\n            border: none;\n            padding: 12px 20px;\n            border-radius: 10px;\n            cursor: pointer;\n            font-size: 16px;\n            transition: background 0.3s;\n        }\n\n        .input-section button:hover {\n            background: #7a8ad6;\n        }\n\n        .filters {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 20px;\n            border-bottom: 2px solid #f0f0f0;\n            padding-bottom: 10px;\n        }\n\n        .filters span {\n            cursor: pointer;\n            font-size: 14px;\n            font-weight: 500;\n            color: #888;\n            transition: color 0.3s;\n        }\n\n        .filters span.active, .filters span:hover {\n            color: #7a8ad6;\n        }\n\n        .task-list {\n            list-style: none;\n            max-height: 350px;\n            overflow-y: auto;\n        }\n\n        .task-list::-webkit-scrollbar {\n            width: 5px;\n        }\n\n        .task-list::-webkit-scrollbar-thumb {\n            background: #d1d1d1;\n            border-radius: 5px;\n        }\n\n        .task {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background: #f9f9f9;\n            padding: 12px 15px;\n            border-radius: 10px;\n            margin-bottom: 10px;\n            transition: all 0.3s;\n        }\n\n        .task:hover {\n            background: #f1f3fa;\n        }\n\n        .task-content {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            flex: 1;\n        }\n\n        .task-content input[type=\"checkbox\"] {\n            appearance: none;\n            width: 20px;\n            height: 20px;\n            border: 2px solid #7a8ad6;\n            border-radius: 5px;\n            cursor: pointer;\n            position: relative;\n        }\n\n        .task-content input[type=\"checkbox\"]:checked {\n            background: #7a8ad6;\n        }\n\n        .task-content input[type=\"checkbox\"]:checked::after {\n            content: '\\2714';\n            position: absolute;\n            color: white;\n            font-size: 14px;\n            top: -1px;\n            left: 3px;\n        }\n\n        .task-text {\n            font-size: 15px;\n            color: #333;\n            word-break: break-all;\n            transition: all 0.3s;\n        }\n\n        .task.completed .task-text {\n            text-decoration: line-through;\n            color: #999;\n        }\n\n        .task-actions {\n            display: flex;\n            gap: 10px;\n        }\n\n        .task-actions button {\n            background: none;\n            border: none;\n            cursor: pointer;\n            font-size: 16px;\n            color: #bbb;\n            transition: color 0.3s;\n        }\n\n        .task-actions .edit-btn:hover {\n            color: #4CAF50;\n        }\n\n        .task-actions .delete-btn:hover {\n            color: #f44336;\n        }\n\n        .clear-btn {\n            width: 100%;\n            padding: 12px;\n            margin-top: 15px;\n            background: #ff6b6b;\n            color: white;\n            border: none;\n            border-radius: 10px;\n            cursor: pointer;\n            font-weight: 500;\n            font-size: 15px;\n            transition: background 0.3s;\n        }\n\n        .clear-btn:hover {\n            background: #ee5253;\n        }\n\n        .empty-message {\n            text-align: center;\n            color: #888;\n            font-size: 14px;\n            margin-top: 20px;\n            display: none;\n        }\n    <\/style>\n<\/head>\n<body>\n\n    <div class=\"todo-container\">\n        <div class=\"header\">\n            <h1><i class=\"fa-solid fa-clipboard-list\"><\/i> My Notes<\/h1>\n        <\/div>\n\n        <div class=\"input-section\">\n            <input type=\"text\" id=\"taskInput\" placeholder=\"Add a new task...\">\n            <button onclick=\"addTask()\"><i class=\"fa-solid fa-plus\"><\/i><\/button>\n        <\/div>\n\n        <div class=\"filters\">\n            <span class=\"active\" id=\"all\" onclick=\"setFilter('all')\">All<\/span>\n            <span id=\"pending\" onclick=\"setFilter('pending')\">Pending<\/span>\n            <span id=\"completed\" onclick=\"setFilter('completed')\">Completed<\/span>\n        <\/div>\n\n        <ul class=\"task-list\" id=\"taskList\">\n            <!-- Tasks will be injected here by JavaScript -->\n        <\/ul>\n        <div class=\"empty-message\" id=\"emptyMessage\">No tasks found!<\/div>\n\n        <button class=\"clear-btn\" onclick=\"clearAll()\">Clear All Tasks<\/button>\n    <\/div>\n\n    <script>\n        const taskInput = document.getElementById('taskInput');\n        const taskList = document.getElementById('taskList');\n        const emptyMessage = document.getElementById('emptyMessage');\n        let todos = JSON.parse(localStorage.getItem('todo-list')) || [];\n        let currentFilter = 'all';\n\n        \/\/ Initialize App\n        showTasks();\n\n        \/\/ Add task on Enter key press\n        taskInput.addEventListener(\"keyup\", e => {\n            if (e.key === \"Enter\" && taskInput.value.trim() !== \"\") {\n                addTask();\n            }\n        });\n\n        \/\/ Function to Add Task\n        function addTask() {\n            const taskText = taskInput.value.trim();\n            if (taskText) {\n                const newTask = {\n                    id: Date.now(),\n                    name: taskText,\n                    status: \"pending\"\n                };\n                todos.push(newTask);\n                taskInput.value = \"\";\n                saveAndRender();\n            } else {\n                alert(\"Please write something!\");\n            }\n        }\n\n        \/\/ Function to Display Tasks\n        function showTasks() {\n            taskList.innerHTML = \"\";\n            let hasTasks = false;\n\n            todos.forEach((todo) => {\n                if (currentFilter === todo.status || currentFilter === \"all\") {\n                    hasTasks = true;\n                    const isCompleted = todo.status === \"completed\" ? \"checked\" : \"\";\n                    const completedClass = todo.status === \"completed\" ? \"completed\" : \"\";\n\n                    const li = document.createElement('li');\n                    li.className = `task ${completedClass}`;\n                    li.innerHTML = `\n                        <div class=\"task-content\">\n                            <input type=\"checkbox\" onclick=\"updateStatus(this, ${todo.id})\" ${isCompleted}>\n                            <span class=\"task-text\">${todo.name}<\/span>\n                        <\/div>\n                        <div class=\"task-actions\">\n                            <button class=\"edit-btn\" onclick=\"editTask(${todo.id}, '${todo.name}')\"><i class=\"fa-solid fa-pen\"><\/i><\/button>\n                            <button class=\"delete-btn\" onclick=\"deleteTask(${todo.id})\"><i class=\"fa-solid fa-trash\"><\/i><\/button>\n                        <\/div>\n                    `;\n                    taskList.appendChild(li);\n                }\n            });\n\n            \/\/ Show empty message if no tasks\n            if (!hasTasks) {\n                emptyMessage.style.display = \"block\";\n            } else {\n                emptyMessage.style.display = \"none\";\n            }\n        }\n\n        \/\/ Function to Update Status (Complete\/Pending)\n        function updateStatus(selectedTask, id) {\n            const todo = todos.find(t => t.id === id);\n            if (selectedTask.checked) {\n                todo.status = \"completed\";\n            } else {\n                todo.status = \"pending\";\n            }\n            saveAndRender();\n        }\n\n        \/\/ Function to Edit Task\n        function editTask(id, currentText) {\n            const newText = prompt(\"Edit your task:\", currentText);\n            if (newText !== null && newText.trim() !== \"\") {\n                const todo = todos.find(t => t.id === id);\n                todo.name = newText.trim();\n                saveAndRender();\n            }\n        }\n\n        \/\/ Function to Delete Task\n        function deleteTask(id) {\n            todos = todos.filter(t => t.id !== id);\n            saveAndRender();\n        }\n\n        \/\/ Function to Set Filter\n        function setFilter(filter) {\n            currentFilter = filter;\n            document.querySelectorAll('.filters span').forEach(span => span.classList.remove('active'));\n            document.getElementById(filter).classList.add('active');\n            showTasks();\n        }\n\n        \/\/ Function to Clear All Tasks\n        function clearAll() {\n            if(todos.length > 0) {\n                if(confirm(\"Are you sure you want to delete all tasks?\")) {\n                    todos = [];\n                    saveAndRender();\n                }\n            }\n        }\n\n        \/\/ Function to Save to LocalStorage and Render\n        function saveAndRender() {\n            localStorage.setItem(\"todo-list\", JSON.stringify(todos));\n            showTasks();\n        }\n    <\/script>\n<\/body>\n<\/html>\n","icon":"\/9j\/4AAQSkZJRgABAQAAAQABAAD\\/2wBDAA0JCgsKCA0LCgsODg0PEyAVExISEyccHhcgLikxMC4pLSwzOko+MzZGNywtQFdBRkxOUlNSMj5aYVpQYEpRUk\/\/2wBDAQ4ODhMREyYVFSZPNS01T09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT0\/\/wAARCABgAGADASIAAhEBAxEB\/8QAGwAAAgMBAQEAAAAAAAAAAAAAAwQBBQYCAAf\/xAA1EAACAgEDAwIEBAUEAwEAAAABAgMRBBIhMQAFQRNRFCJhcQYygZEjQqGx8BVScsGC0fHh\/8QAGQEAAgMBAAAAAAAAAAAAAAAAAQIAAwQF\/8QAIREAAgICAgMAAwAAAAAAAAAAAAECEQMhEjEEQVETIoH\/2gAMAwEAAhEDEQA\/AM7JGpNwnFKjYn1BGd2DE0w3o0PJ4256kPIiV8PJoUGk1KbAPDMN9NhjX3HvQjPPLonkMKxsNKtMTTcgj9LPO3vVgdMy4j+jH6pXIx4aC6AzaiAdtqsbe+1fc9c